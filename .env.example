# Singularity — environment reference
#
# Copy to `.env` and set what your installation needs. Every variable here has a
# working default for local development; the point of setting one is to move a
# decision out of code.
#
# Never commit the real `.env`. Anything that authenticates — a database
# password, a provider API key — belongs there and nowhere else.
#
# Singularity is a Sabatier Service application, so every variable the framework
# reads is available here too. See ../Service/.env.example for the full
# reference: authentication, CORS, rate limiting, idempotency, security headers
# and MCP transport. This file covers what Singularity itself needs.


# ── Environment ──────────────────────────────────────────────────────────────
# Only the exact value "development" surfaces the exception message in an error
# response. Every other value — "production", a typo, or leaving this unset —
# hides it.
APP_ENV=development


# ── Frontend ─────────────────────────────────────────────────────────────────
# Point this at the Vite dev server for hot reload while working on the
# TypeScript frontend (`npm run dev`). Leave it commented out to load assets
# from the production build through Build/.vite/manifest.json instead.
#VITE_DEV_SERVER=http://127.0.0.1:5173

# Directories served as static files, relative to the document root.
STATIC_PUBLIC_DIRECTORIES=Build


# ── Database ─────────────────────────────────────────────────────────────────
# The MariaDB schema backing the editor's own store. Singularity is modeled in
# its own editor, so this is the store its managed objects live in.
SQL_SCHEMA_NAME=Singularity
SQL_SCHEMA_HOST=127.0.0.1
SQL_SCHEMA_CREDENTIAL_USER=
SQL_SCHEMA_CREDENTIAL_PASSWORD=


# ── MCP server ───────────────────────────────────────────────────────────────
# Identity reported to an MCP client during the `initialize` handshake.
MCP_SERVER_NAME=Singularity
MCP_SERVER_VERSION=1.0.0


# ── Rate limiting ────────────────────────────────────────────────────────────
# Off for local development. The framework default is true; leave it on for any
# installation reachable by anything other than you.
RATE_LIMIT_ENABLED=false


# ── Debugging ────────────────────────────────────────────────────────────────
# Verbose libcurl output from Foundation's URLSession. Default: false
URL_SESSION_DEBUG_LIBCURL=false
