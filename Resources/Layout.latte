<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{block title}{/block}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css">
    <link rel="stylesheet" type="text/css" href="/Resources/Layout.css" media="screen">
</head>
<body>
{block content}{/block}
<div class="modal fade" id="removeModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="removeModal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="POST">
                <div class="modal-header">
                </div>
                <div class="modal-body">
                    <h5 class="modal-title mb-3" id="removeModal"></h5>
                    <div class="modal-message">This action cannot bet undone.</div>
                </div>
                <div class="modal-footer border-0">
                    <input type="hidden" name="X-Http-Method-Override" value="DELETE">
                    <button type="button" class="btn btn-outline-secondary border-0 bg-transparent text-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-outline-primary border-0 bg-transparent text-primary">
                        Remove
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous" defer></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.min.js" integrity="sha384-Rx+T1VzGupg4BHQYs2gCW9It+akI2MM/mndMCy36UVfodzcJcF0GGLxZIzObiEfa" crossorigin="anonymous" defer></script>
<!--suppress JSCheckFunctionSignatures -->
<script>
  function url(endpoint, parameters) {
    let url = endpoint
    if (url.startsWith("/")) {
      url = "/" + url
    }
    if (!!parameters && JSON.stringify(parameters) !== JSON.stringify({})) {
      url += "?" + (() => {
        let array = []
        for (const k in parameters) {
          if (parameters.hasOwnProperty(k)) {
            array.push(encodeURIComponent(k) + "=" + encodeURIComponent(parameters[k]))
          }
        }
        return array.join("&")
      })()
    }
    return url
  }

  async function load(url) {
    return (await fetch(url)).text()
  }

  async function replace(url) {
    const data = await load(url)
    const doc = document.implementation.createHTMLDocument()
    doc.open()
    doc.write(data)
    doc.close()
    const e2 = doc.getElementById("content")
    const e1 = document.getElementById("content")
    e1.innerHTML = e2.innerHTML
    didLoad()
    return data
  }

  async function push(url) {
    const data = await replace(url)
    if (window.location !== url) {
      window.history.pushState({}, "", url)
    }
    return data
  }

  async function submit(form) {
    let headers = {}
    headers["X-Requested-With"] = "XmlHttpRequest"
    headers["Content-Type"] = "application/json; charset=utf-8"
    let elements = Array.from(form.elements)
    const method = elements.find(e => e.name === "X-Http-Method-Override")?.value ?? "POST"
    const filtered = elements.filter(e => e.type !== "submit" && e.name !== "X-Http-Method-Override")
    const body = JSON.stringify(filtered.reduce((result, e) => {
      result[e.name] = (() => {
        let value = e.type === "checkbox" ? e.checked : e.value
        if (value === "true") {
          return true
        } else if (value === "false") {
          return false
        } else if (!isNaN(value) && !isNaN(parseFloat(value))) {
          return parseFloat(value)
        } else if (value === "") {
          return null
        }
        return value
      })()
      return result
    }, {}))
    const response = await fetch(form.action, {
      method: method,
      headers: headers,
      body: body
    })
    if (!response.ok) {
      throw new Error(await response.text())
    }
    let url = new URL(window.location)
    if (method === "DELETE") {  
      let keys = ["project"]
      const destinationURL = new URL(form.action)
      switch(destinationURL.pathname.replace("/", "")) {
        case "Attribute":
        case "Relationship":
        case "FetchedProperty":
        case "FetchIndex":
        case "UniquenessConstraint":
          keys.push("entity")
          break
        case "FetchIndexElement":
          keys.push(...["entity", "index"])
      }
      url.search = keys.map(k => k + "=" + url.searchParams.get(k)).join("&")
    }
    await push(url.href)
    return response
  }

  async function remove(sender, item) {
    const action = sender.getAttribute("data-bs-action-name")
    const endpoint = action.split(" ").join("")
    const element = document.getElementById("removeModal")
    const title = element.querySelector(".modal-title")
    title.textContent = "Remove " + action.toLowerCase() + " \"" + (item.name ?? item.propertyName ?? item.stringValue) + "\"?"
    const form = element.querySelector(".modal-content form")
    form.action = url(endpoint, {
      objectID: item.objectID
    })
    const modal = new bootstrap.Modal(element, {})
    modal.show()
  }

  function showPreferences() {
    window.open("/Preferences", "_blank", "popup=true, noopener, noreferrer, width=600, height=400")
  }
</script>
<!--suppress JSCheckFunctionSignatures -->
<script>
  function layout() {
    document.querySelectorAll(`[class*="overflow-auto"]`).forEach(e => e.style.height = document.documentElement.clientHeight - 98 + "px")
  }

  function didLoad() {
    layout()
    window.addEventListener("resize", layout)
    document.addEventListener("DOMContentLoaded", layout)
    document.querySelectorAll("span[data-href]").forEach(e => {
      e.addEventListener("click", async () => {
        try {
          await push(e.dataset.href)
          const span = document.getElementById(e.id)
          if (span instanceof Element) {
            span.scrollIntoView({
              behavior: "instant",
              block: "end",
              inline: "nearest"
            })
          }
        } catch (error) {
          console.error(error)
        }
      })
    })
    document.querySelectorAll("tr[data-href]").forEach(e => {
      e.addEventListener("click", async () => {
        try {
          await push(e.dataset.href)
          const tr = document.getElementById(e.id)
          if (tr instanceof Element) {
            tr.scrollIntoView({
              behavior: "instant",
              block: "end",
              inline: "nearest"
            })
          }
        } catch (error) {
          console.error(error)
        }
      })
    })
    document.querySelectorAll("input[type=checkbox]").forEach(e => {
      e.addEventListener("click", async () => {
        try {
          await submit(e.form)
        } catch (error) {
          console.error(error)
        }
      })
    })
    document.querySelectorAll("select[autosave]").forEach(e => {
      e.addEventListener("change", async () => {
        try {
          await submit(e.form)
        } catch (error) {
          console.error(error)
        }
      })
    })
    document.querySelectorAll("form").forEach(e => {
      e.addEventListener("submit", async (event) => {
        event.preventDefault()
        if (event.submitter) {
          try {
            await submit(e)
          } catch (error) {
            console.error(error)
          }
        }
      })
    })
    const addModal = document.getElementById("addModal")
    if (addModal) {
      addModal.addEventListener("show.bs.modal", event => {
        const button = event.relatedTarget
        const action = button.getAttribute("data-bs-action-name")
        const endpoint = action.split(" ").join("")
        const modalTitle = addModal.querySelector(".modal-title")
        modalTitle.textContent = "Add " + action
        const modalContentForm = addModal.querySelector(".modal-content form")
        modalContentForm.action = url(endpoint)
      })
    }
  }

  didLoad()
</script>
</body>
</html>
