{layout 'Layout.latte'}
{varType string $title}
{varType string $companyName}
{block title}Preferences - {$title}{/block}
{block content}
    <div class="container-fluid user-select-none" style="height: 380px;">
        <div class="card border-0 h-100">
                <div class="card-body d-flex flex-column">
                    <form class="h-100" action="/Synchronize" method="POST">
                        <div class="mb-3">
                            <label for="CompanyName" class="form-label">Company Name</label>
                            <input type="text" name="CompanyName" id="CompanyName" placeholder="Company Name" class="form-control" value="{$companyName}" autocomplete="off" required>
                        </div>
                        <div class="form-check mb-3">
                            <label class="form-check-label" for="AutomaticallyDeleteProjectFolders">Deleting a project also deletes its folder</label>
                            <input class="form-check-input" type="checkbox" name="AutomaticallyDeleteProjectFolders" value="{$automaticallyDeleteProjectFolders}" id="automaticallyDeleteProjectFolders" {$automaticallyDeleteProjectFolders ? checked}>
                        </div>
                        <button type="submit" class="btn btn-outline-primary mt-auto">
                            Save
                        </button>
                    </form>
                </div>
            </div>
    </div>
{/block}
