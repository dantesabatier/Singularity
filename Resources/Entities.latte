{varType App\Model\Project $project}
{varType App\Model\Entity $selectedEntity}
{varType App\Model\FetchIndex $selectedIndex}
{varType Sabatier\Foundation\ArrayClass $entities}
{define entities, $entities, $flag}
    <ul class="{!$flag ? 'flex-column w-100 ps-0' : 'flex-column w-100'}">
        {foreach $entities as $entity}
            <li class="{$entity->objectID->referenceObject === $selectedEntity?->objectID?->referenceObject ? 'selected'}">
                {if !$entity->subentitiesCount}
                    <span class="space"></span>
                {else}
                    <button class="btn btn-toggle bg-transparent ps-2" type="button" data-bs-toggle="collapse" data-bs-target="#{$entity->name}" aria-controls="{$entity->name}" aria-expanded="true">
                    </button>
                {/if}
                <span id="entity-{$entity->objectID->referenceObject}" class="nav-toggle{$selectedIndex === null && $entity->objectID->referenceObject === $selectedEntity?->objectID?->referenceObject ? ' active'}" data-href="/Editor?project={$project?->objectID?->referenceObject}&entity={$entity->objectID->referenceObject}">{$entity->name}
                </span>
                {if $entity->indexesCount}
                    <ul class="flex-column w-100">
                        {foreach $entity->indexes as $index}
                            <li>
                                <span class="space"></span>
                                <span id="index-{$index->objectID->referenceObject}" class="nav-toggle{$index->objectID->referenceObject === $selectedIndex?->objectID?->referenceObject ? ' active'}" data-href="/Editor?project={$project?->objectID?->referenceObject}&entity={$entity->objectID->referenceObject}&index={$index->objectID->referenceObject}">{$index->name}</span>
                            </li>
                        {/foreach}
                    </ul>
                {/if}
                {if $entity->subentitiesCount}
                    <div class="collapse show" id="{$entity->name}">
                        {include entities, $entity->subentities, true}
                    </div>
                {/if}
            </li>
        {/foreach}
    </ul>
{/define}
