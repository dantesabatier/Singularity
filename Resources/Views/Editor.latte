{layout "Layout.latte"}
{templateType App\Contexts\Editor}
{block title}{$project?->name} - {$title}{/block}
{block content}
    <div id="main">
        <nav class="navbar navbar-expand-sm fixed-top border-bottom py-0" style="height: 56px">
            <div class="container-fluid">
                <div class="btn-group">
                    <button class="btn btn-sm btn-back border-0 bg-transparent" onclick="history.back()">
                        <span class="material-symbols-outlined">arrow_back_ios</span> <span>Back</span>
                    </button>
                    <div class="dropdown">
                        <button type="button" class="btn btn-sm border-0 bg-transparent p-2 dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            {$project?->name}
                        </button>
                        <ul class="dropdown-menu">
                            {foreach $projects as $i => $e}
                                <li>
                                    <button class="dropdown-item" type="button" onclick="open({$e})">{$e->name}</button>
                                </li>
                                <li n:if="$projects->count > 1 && $i === 0">
                                    <hr class="dropdown-divider">
                                </li>
                            {/foreach}
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li>
                                <form class="d-flex" action="/Save" method="POST">
                                    <input type="hidden" name="project" value="{$project?->objectID?->referenceObject}">
                                    <button class="dropdown-item" type="submit">
                                        Save
                                    </button>
                                </form>
                            </li>
                            <li>
                                <button class="dropdown-item" type="button" onclick="push('/')">Close</button>
                            </li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button type="button" class="btn btn-sm border-0 bg-transparent p-2 dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            Editor
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#addEntity">
                                    Add Entity
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#addFetchRequest">
                                    Add Fetch Request
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item" disabled>
                                    Add Configuration
                                </button>
                            </li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li>
                                <button class="dropdown-item" type="button" onclick="add({App\Model\Attribute::entity()->name}, {$selectedEntity})" {!$selectedEntity instanceof App\Model\Entity ? disabled}>
                                    Add Attribute
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item" type="button" onclick="add({App\Model\FetchedProperty::entity()->name}, {$selectedEntity})" {!$selectedEntity instanceof App\Model\Entity ? disabled}>
                                    Add Fetched Property
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item" type="button" onclick="add({App\Model\Relationship::entity()->name}, {$selectedEntity})" {!$selectedEntity instanceof App\Model\Entity ? disabled}>
                                    Add Relationship
                                </button>
                            </li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li>
                                <button class="dropdown-item" type="button" onclick="add({App\Model\FetchIndex::entity()->name}, {$selectedEntity})" {!$selectedEntity instanceof App\Model\Entity || $selectedEntity->attributes->isEmpty ? disabled}>
                                    Add Fetch Index
                                </button>
                            </li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li>
                                <button class="dropdown-item" onclick="subclass({$project})">
                                    Create ManagedObject Subclass...
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item" onclick="model({$project})">
                                    Import...
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="spinner-border spinner-border-sm text-primary float-end" role="status" hidden>
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </nav>
        <div class="container-fluid d-flex flex-column p-0">
            <div class="row flex-grow-1" style="padding-top: 56px;">
                <nav class="border-bottom small py-0" aria-label="breadcrumb" style="--bs-breadcrumb-divider: '>';height: 36px">
                    <ol class="breadcrumb mt-1 ms-2" style="height: 24px">
                        <li n:foreach="$breadcrumb as $item" class="breadcrumb-item">
                            {var string $img = img($item)}
                            {if $img}<img class="ps-2" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">{/if}
                            {switch true}
                                {case $item instanceof App\Model\Project}
                                <span class="nav-toggle" data-href="/Editor?project={$item->objectID->referenceObject}">{$item->name}</span>
                            {case $item instanceof App\Model\Entity}
                                <span class="nav-toggle" data-href="/Editor?project={$project->objectID->referenceObject}&entity={$item->objectID->referenceObject}">{$item->name}</span>
                            {case $item instanceof App\Model\FetchRequestTemplate}
                                <span class="nav-toggle" data-href="/Editor?project={$project->objectID->referenceObject}&fetchRequest={$item->objectID->referenceObject}">{$item->name}</span>
                            {case $item instanceof App\Model\UniquenessConstraint}
                                <span class="nav-toggle" data-href="/Editor?project={$project->objectID->referenceObject}&constraint={$item->objectID->referenceObject}">{$item->stringValue}</span>
                            {case $item instanceof App\Model\Property}
                                <span class="nav-toggle" data-href="/Editor?project={$project->objectID->referenceObject}&entity={$selectedEntity->objectID->referenceObject}&property={$item->objectID->referenceObject}">{$item->name}</span>
                            {case $item instanceof App\Model\FetchIndex}
                                <span class="nav-toggle" data-href="/Editor?project={$project->objectID->referenceObject}&entity={$selectedEntity->objectID->referenceObject}&index={$item->objectID->referenceObject}">{$item->name}</span>
                            {case $item instanceof App\Model\FetchIndexElement}
                                <span class="nav-toggle" data-href="/Editor?project={$project->objectID->referenceObject}&entity={$selectedEntity->objectID->referenceObject}&index={$selectedIndex->objectID->referenceObject}&element={$item->objectID->referenceObject}">{$item->propertyName}</span>
                            {/switch}
                        </li>
                    </ol>
                </nav>
                <div id="source" class="scroll-view col-sm-3 border-end overflow-auto px-0" style="height: 85vh;">
                    {include sourceList from "SourceList.latte"}
                </div>
                <div id="content" class="scroll-view col-sm-6 overflow-auto" style="height: 85vh;">
                    {include content from "Content.latte"}
                </div>
                <div id="sidebar" class="scroll-view col-sm-3 border-start overflow-auto" style="height: 85vh;">
                    {include inspector from "Inspector.latte"}
                </div>
            </div>
            <div class="row border-top" style="height: 40px;">
                <div class="col-sm-3">
                    {include controls from "Controls.latte"}
                </div>
                <div class="col-sm-6">
                </div>
                <div class="col-sm-3">
                </div>
            </div>
        </div>
        <div class="modal fade" id="addEntity" data-bs-backdrop="static" tabindex="-1" aria-labelledby="addEntityLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form action="/Entity" id="addEntity" method="POST">
                        <div class="modal-body">
                            <div class="mb-3">
                                <h5 class="modal-title" id="addEntityLabel">Add Entity</h5>
                            </div>
                            <div class="mb-3">
                                <label for="name" class="form-label">Name</label>
                                <input type="text" name="name" id="name" class="form-control form-control-sm" autocomplete="off" required>
                            </div>
                            <label for="superentityID" class="form-label">Parent Entity</label>
                            <select name="superentityID" id="superentityID" class="form-select form-select-sm" {$allEntities->isEmpty ? disabled}>
                                <option value="">No Parent Entity</option>
                                <hr>
                                <option n:foreach="$allEntities as $entity" value="{$entity->objectID->referenceObject}">
                                    {$entity->name}
                                </option>
                            </select>
                        </div>
                        <div class="modal-footer border-0">
                            <input type="hidden" name="modelID" value="{$project?->model?->objectID?->referenceObject}">
                            <button type="button" class="btn btn-outline-secondary border-0 bg-transparent text-secondary" data-bs-dismiss="modal">
                                Cancel
                            </button>
                            <button type="submit" class="btn btn-outline-primary border-0 bg-transparent text-primary">
                                Add
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="modal fade" id="addFetchRequest" data-bs-backdrop="static" tabindex="-1" aria-labelledby="addFetchRequestLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form action="/FetchRequestTemplate" method="POST">
                        <div class="modal-body">
                            <div class="mb-3">
                                <h5 class="modal-title" id="addFetchRequestLabel">Add Fetch Request</h5>
                            </div>
                            <div class="mb-3">
                                <label for="name" class="form-label">Name</label>
                                <input type="text" name="name" id="name" class="form-control form-control-sm" autocomplete="off" required>
                            </div>
                        </div>
                        <div class="modal-footer border-0">
                            <input type="hidden" name="modelID" value="{$project?->model?->objectID?->referenceObject}">
                            <button type="button" class="btn btn-outline-secondary border-0 bg-transparent text-secondary" data-bs-dismiss="modal">
                                Cancel
                            </button>
                            <button type="submit" class="btn btn-outline-primary border-0 bg-transparent text-primary">
                                Add
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{/block}
