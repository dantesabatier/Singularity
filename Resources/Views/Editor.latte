{layout "Layout.latte"}
{templateType App\Contexts\Editor}
{block title}{$project?->name}{/block}
{block content}
    <div id="main" class="user-select-none">
        <nav class="navbar sticky-top bg-dark border-bottom border-black user-select-none p-0" style="height: 40px">
            <div class="container-fluid justify-content-start">
                <div class="navbar-brand">
                    <!--suppress CheckImageSize -->
                    <img src="/Resources/Images/icon.png" alt="Logo" width="24" height="24" class="d-inline-block align-text-top">
                </div>
                <div class="dropdown">
                    <button class="btn icon px-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="material-symbols-outlined">menu</span>
                    </button>
                    <ul class="dropdown-menu">
                        <li>
                            <button class="dropdown-item" type="button" onclick="add({App\Model\Entity::entity()->name}, {App\Model\Entity::entity()->name}, {$project->model}, register)">
                                Add Entity
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="add({App\Model\FetchRequestTemplate::entity()->name}, {App\Model\FetchRequestTemplate::entity()->name|firstLower}, {$project->model}, register)">
                                Add Fetch Request
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="add({App\Model\Configuration::entity()->name}, {App\Model\Configuration::entity()->name}, {$project->model}, register)">
                                Add Configuration
                            </button>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="add({App\Model\Attribute::entity()->name}, {App\Model\Attribute::entity()->name|firstLower}, {$selection}, register)" {!$selection instanceof App\Model\Entity ? disabled}>
                                Add Attribute
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="add({App\Model\FetchedProperty::entity()->name}, {App\Model\FetchedProperty::entity()->name|firstLower}, {$selection}, register)" {!$selection instanceof App\Model\Entity ? disabled}>
                                Add Fetched Property
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="add({App\Model\Relationship::entity()->name}, {App\Model\Relationship::entity()->name|firstLower}, {$selection}, register)" {!$selection instanceof App\Model\Entity ? disabled}>
                                Add Relationship
                            </button>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="add({App\Model\FetchIndex::entity()->name}, {App\Model\FetchIndex::entity()->name|firstLower}, {$selection}, register)" {!$selection instanceof App\Model\Entity || $selection->attributes->isEmpty ? disabled}>
                                Add Fetch Index
                            </button>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <button class="dropdown-item" onclick="remove({$selection}, register)" {!$selection ? disabled}>
                                Remove
                            </button>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <button class="dropdown-item" onclick="save({$project}, register)">
                                Save
                            </button>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <button class="dropdown-item" onclick="subclass({$project}, register)">
                                Create ManagedObject Subclass...
                            </button>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <button class="dropdown-item" onclick="model({$project}, {$project->model?->url}, register)">
                                Import...
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="container-fluid d-flex flex-column">
            <div class="row">
                <div id="source" class="scroll-view col-sm-3 border-end border-black" style="height: calc(100vh - 68px)">
                    {include sourceList from "SourceList.latte"}
                </div>
                <div id="content" class="scroll-view col-sm-6" style="height: calc(100vh - 68px)">
                    {include content from "Content.latte"}
                </div>
                <div id="sidebar" class="scroll-view col-sm-3 border-start border-black" style="height: calc(100vh - 68px)">
                    {include inspector from "Inspector.latte"}
                </div>
            </div>
        </div>
        <nav class="fixed-bottom border-top border-black py-0" aria-label="breadcrumb" style="--bs-breadcrumb-divider: '>'; height: 28px">
            <ol class="breadcrumb">
                <li n:foreach="$breadcrumb as $item" class="breadcrumb-item">
                    {var string $img = img($item)}
                    {if $item instanceof App\Model\Project}
                        <div class="nav-item" data-href="/Editor?project={$project?->objectID?->referenceObject}">
                            <img class="ps-1" n:if="$img" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">
                            <span class="ps-2 pe-1 align-self-center">{$item->name}</span>
                        </div>
                    {elseif $item instanceof App\Model\Model}
                        <div class="nav-item">
                            <img class="ps-1" n:if="$img" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">
                            <div class="dropdown">
                                <button type="button" class="btn icon ps-2 pe-1" data-bs-toggle="dropdown" aria-expanded="false">
                                    {$project->name}
                                </button>
                                <ul class="dropdown-menu">
                                    <li n:foreach="$item->entities as $entity">
                                        <a class="dropdown-item" href="/Editor?project={$project->objectID->referenceObject}&entity={$entity->objectID->referenceObject}">{$entity->name}</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    {elseif $item instanceof App\Model\Entity}
                        <div class="nav-item">
                            <img class="ps-1" n:if="$img" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">
                            <div class="dropdown">
                                <button type="button" class="btn icon ps-2 pe-1" data-bs-toggle="dropdown" aria-expanded="false">
                                    {$item->name}
                                </button>
                                <ul class="dropdown-menu">
                                    <li n:foreach="$item->properties as $property">
                                        <a class="dropdown-item" href="/Editor?project={$project->objectID->referenceObject}&entity={$item->objectID->referenceObject}&property={$property->objectID->referenceObject}">{$property->name}</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    {elseif $item instanceof App\Model\FetchRequestTemplate}
                        <div class="nav-item">
                            <img class="ps-1" n:if="$img" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">
                            <span class="ps-2 pe-1 align-self-center">{$item->name}</span>
                        </div>
                    {elseif $item instanceof App\Model\UniquenessConstraint}
                        <div class="nav-item">
                            <img class="ps-1" n:if="$img" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">
                            <span class="ps-2 pe-1 align-self-center">{$item->stringValue}</span>
                        </div>
                    {elseif $item instanceof App\Model\Property}
                        <div class="nav-item">
                            <img class="ps-1" n:if="$img" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">
                            <span class="ps-2 pe-1 align-self-center">{$item->name}</span>
                        </div>
                    {elseif $item instanceof App\Model\FetchIndex}
                        <div class="nav-item">
                            <img class="ps-1" n:if="$img" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">
                            <div class="dropdown">
                                <button type="button" class="btn icon ps-2 pe-1" data-bs-toggle="dropdown" aria-expanded="false">
                                    {$item->name}
                                </button>
                                <ul class="dropdown-menu">
                                    <li n:foreach="$item->elements as $element">
                                        <a class="dropdown-item" href="/Editor?project={$project->objectID->referenceObject}&entity={$selectedEntity->objectID->referenceObject}&index={$item->objectID->referenceObject}&element={$element->objectID->referenceObject}">{$element->propertyName}</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    {elseif $item instanceof App\Model\FetchIndexElement}
                        <div class="nav-item">
                            <img class="ps-1" n:if="$img" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">
                            <span class="ps-2 pe-1">{$item->propertyName}</span>
                        </div>
                    {/if}
                </li>
            </ol>
        </nav>
    </div>
{/block}
