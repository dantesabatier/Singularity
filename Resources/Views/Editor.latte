{layout "Layout.latte"}
{templateType App\Contexts\Editor}
{block title}{$project?->name}{/block}
{block content}
    <div id="main" class="user-select-none">
        <div class="container-fluid d-flex flex-column">
            <div class="row">
                <nav class="border-bottom border-black py-0" aria-label="breadcrumb" style="--bs-breadcrumb-divider: '>'; height: 28px">
                    <ol class="breadcrumb">
                        <li n:foreach="$breadcrumb as $item" class="breadcrumb-item small">
                            {var string $img = img($item)}
                            {if $item instanceof App\Model\Model}
                                <div class="nav-item">
                                    <img n:if="$img" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">
                                    <div class="dropdown">
                                        <button type="button" class="btn border-0 bg-transparent" data-bs-toggle="dropdown" aria-expanded="false">
                                            {$project->name}
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li n:foreach="$item->entities as $entity">
                                                <a class="dropdown-item ps-2" href="/Editor?project={$project->objectID->referenceObject}&entity={$entity->objectID->referenceObject}">{$entity->name}</a>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            {elseif $item instanceof App\Model\Entity}
                                <div class="nav-item">
                                    <img n:if="$img" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">
                                    <div class="dropdown">
                                        <button type="button" class="btn border-0 bg-transparent" data-bs-toggle="dropdown" aria-expanded="false">
                                            {$item->name}
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li n:foreach="$item->properties as $property">
                                                <a class="dropdown-item" href="/Editor?project={$project->objectID->referenceObject}&entity={$item->objectID->referenceObject}&property={$property->objectID->referenceObject}">{$property->name}</a>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            {elseif $item instanceof App\Model\FetchRequestTemplate}
                                <div class="nav-item">
                                    <img n:if="$img" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">
                                    <span class="ps-2">{$item->name}</span>
                                </div>
                            {elseif $item instanceof App\Model\UniquenessConstraint}
                                <div class="nav-item">
                                    <img n:if="$img" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">
                                    <span class="ps-2">{$item->stringValue}</span>
                                </div>
                            {elseif $item instanceof App\Model\Property}
                                <div class="nav-item">
                                    <img n:if="$img" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">
                                    <span class="ps-2">{$item->name}</span>
                                </div>
                            {elseif $item instanceof App\Model\FetchIndex}
                                <div class="nav-item">
                                    <img n:if="$img" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">
                                    <div class="dropdown">
                                        <button type="button" class="btn border-0 bg-transparent" data-bs-toggle="dropdown" aria-expanded="false">
                                            {$item->name}
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li n:foreach="$item->elements as $element">
                                                <a class="dropdown-item" href="/Editor?project={$project->objectID->referenceObject}&entity={$selectedEntity->objectID->referenceObject}&index={$item->objectID->referenceObject}&element={$element->objectID->referenceObject}">{$element->propertyName}</a>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            {elseif $item instanceof App\Model\FetchIndexElement}
                                <div class="nav-item">
                                    <img n:if="$img" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">
                                    <span class="ps-2">{$item->propertyName}</span>
                                </div>
                            {/if}
                        </li>
                    </ol>
                </nav>
                <div id="source" class="scroll-view col-sm-3 border-end border-black">
                    {include sourceList from "SourceList.latte"}
                </div>
                <div id="content" class="scroll-view col-sm-6">
                    {include content from "Content.latte"}
                </div>
                <div id="sidebar" class="scroll-view col-sm-3 border-start border-black">
                    {include inspector from "Inspector.latte"}
                </div>
            </div>
            <div class="row fixed-bottom border-top border-black" style="height: 40px;">
                <div class="col-sm-3">
                    {include controls from "Controls.latte"}
                </div>
                <div class="col-sm-6">
                </div>
                <div class="col-sm-3 text-end">
                    {include actions from "Actions.latte"}
                </div>
            </div>
        </div>
    </div>
{/block}
