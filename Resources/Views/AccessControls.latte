{templateType App\ViewControllers\EditorController}
{define accessControls}
    <div class="inspector-header">Access Control</div>
    <div class="ide-list-control">
        <div class="accessControl-cards">
            <div n:foreach="$selectedProperty?->accessControls ?? [] as $accessControl" id="accessControl-{$accessControl->objectID|json}" data-href="/Editor?project={$project->objectID|json}&entity={$selectedEntity->objectID|json}&property={$selectedProperty->objectID|json}&accessControl={$accessControl->objectID|json}" n:class="'accessControl-card', $accessControl->isEqual($selectedAccessControl) ? active">
                <div class="accessControl-card-header">
                    <form action="/AccessControl" method="POST" class="accessControl-enabled-form">
                        <input type="hidden" name="X-Http-Method-Override" value="PATCH">
                        <input type="hidden" name="objectID" value="{$accessControl->objectID|json}">
                        <input class="form-check-input" type="checkbox" name="isEnabled" value="{$accessControl->isEnabled|json}" aria-label="Enabled" {$accessControl->isEnabled ? checked}>
                    </form>
                    <span class="accessControl-name-badge accessControl-type-{$accessControl->name}">#{$accessControl->name}</span>
                    <form action="/AccessControl" method="POST" class="accessControl-scope-form">
                        <input type="hidden" name="X-Http-Method-Override" value="PATCH">
                        <input type="hidden" name="objectID" value="{$accessControl->objectID|json}">
                        <input type="hidden" name="scope" value="{$accessControl->scope->value}">
                        <select name="scope" aria-label="Scope" class="form-select transparent" data-editor-change="accessControlScope">
                            <option n:foreach="$scopes as $scope" value="{$scope->value}" {$accessControl->scope->value === $scope->value ? selected}>
                                {$scope->name}
                            </option>
                        </select>
                    </form>
                </div>
                <div class="accessControl-card-roles">
                    <span n:foreach="$accessControl->roles as $role" class="role-badge-wrapper">
                        <span class="role-badge" data-bs-toggle="popover" data-bs-html="true" data-bs-content="" data-bs-custom-class="role-popover" data-role="{$role->objectID|json}" data-access-control="{$accessControl->objectID|json}">
                            {$role->name}
                        </span>
                        <button type="button"
                                class="role-badge-delete"
                                data-editor-action="removeSelection"
                                data-item="{$role|json}"
                                title="Remove role"
                                aria-label="Remove {$role->name}">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </span>
                    <span n:if="$accessControl->roles->isEmpty" class="accessControl-roles-empty">Any role</span>
                    <button type="button"
                            class="role-add-btn"
                            data-editor-action="addRole"
                            data-parent="{$accessControl|json}"
                            title="Add role"
                            aria-label="Add role">
                        <span class="material-symbols-outlined">add</span>
                    </button>
                </div>
                <button type="button" class="condition-trigger {if !$accessControl->predicateString}condition-trigger-empty{/if}" data-bs-toggle="popover" data-bs-html="true" data-bs-content="" data-bs-custom-class="condition-popover" data-access-control="{$accessControl->objectID|json}" aria-label="{$accessControl->predicateString ? "Edit condition" : "Add condition"}">
                    {if $accessControl->predicateString}
                        <span class="condition-badge" title="{$accessControl->predicateString}">{$accessControl->predicateString}</span>
                    {else}
                        <span class="material-symbols-outlined">add</span> Condition
                    {/if}
                </button>
            </div>
            <div n:if="$selectedProperty?->accessControls?->isEmpty ?? true" class="accessControl-empty">
                Readable and writable by any role
            </div>
        </div>
        <div class="list-control-toolbar">
            <div class="dropdown">
                <button class="btn btn-icon dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Add Access Control">
                    <span class="material-symbols-outlined">add</span>
                </button>
                <ul class="dropdown-menu">
                    <li><h6 class="dropdown-header">Access Control</h6></li>
                    <li>
                        <button class="dropdown-item"
                                data-editor-action="addReadableAccessControl"
                                data-parent="{$selectedProperty|json}">
                            <span class="accessControl-name-badge accessControl-type-Readable">#Readable</span>
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item"
                                data-editor-action="addWritableAccessControl"
                                data-parent="{$selectedProperty|json}">
                            <span class="accessControl-name-badge accessControl-type-Writable">#Writable</span>
                        </button>
                    </li>
                </ul>
            </div>
            <button class="btn btn-icon"
                    title="Remove Access Control"
                    data-editor-action="removeSelection"
                    data-item="{$selectedAccessControl|json}" {!$selectedAccessControl instanceof App\Model\AccessControl ? disabled}>
                <span class="material-symbols-outlined">remove</span>
            </button>
        </div>
    </div>

    {if $selectedAccessControl instanceof App\Model\AccessControl}
        <template id="condition-popover-content">
            <form action="/AccessControl" method="POST" class="condition-popover-form">
                <input type="hidden" name="X-Http-Method-Override" value="PATCH">
                <input type="hidden" name="objectID" value="{$selectedAccessControl->objectID|json}">
                <div class="condition-popover-field">
                    <label for="conditionPredicate" class="condition-popover-label">Predicate Format</label>
                    <textarea name="predicateString" id="conditionPredicate" class="form-control form-control-sm code-editor condition-textarea" rows="4" autocomplete="off" spellcheck="false" placeholder="status == 1 AND department == $SUBJECT.department">{$selectedAccessControl->predicateString}</textarea>
                </div>
                <div class="condition-popover-vars">
                    <span class="condition-vars-label">Access variables</span>
                    <code class="sp-chip" data-copy="$SUBJECT">$SUBJECT</code>
                    <code class="sp-chip" data-copy="$ENVIRONMENT">$ENVIRONMENT</code>
                    <code class="sp-chip" data-copy="$FETCH_SOURCE">$FETCH_SOURCE</code>
                </div>
                <div class="condition-popover-actions">
                    <button type="button" class="btn btn-sm btn-secondary condition-cancel-btn">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary condition-save-btn">Save</button>
                </div>
            </form>
        </template>
    {/if}
{/define}
