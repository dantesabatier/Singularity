{templateType App\ViewControllers\EditorController}
{define entity}
    <div class="px-3 pb-4">
        <form action="/Entity" method="POST">
            <input type="hidden" name="objectID" value="{$selectedEntity->objectID->referenceObject}">
            <div class="inspector-header">Entity Identity</div>
            <div class="row mb-2">
                <label for="name" class="col-sm-4 inspector-label">Name</label>
                <div class="col-sm-8">
                    <input type="text" name="name" id="name" placeholder="Entity Name" class="form-control form-control-sm text-truncate fw-bold" value="{$selectedEntity->name}" autocomplete="off" spellcheck="false" required>
                </div>
            </div>
            <div class="row mb-2">
                <label for="superentityID" class="col-sm-4 inspector-label">Parent</label>
                <div class="col-sm-8">
                    <select name="superentityID" id="superentityID" class="form-select form-select-sm" data-autosave="true">
                        <option value="">No Parent Entity</option>
                        <option disabled>──────────</option>
                        <option n:foreach="$project->model->entities as $entity" value="{$entity->objectID->referenceObject}" {$entity->name === $selectedEntity->superentity?->name ? selected} {$entity->objectID->referenceObject == $selectedEntity->objectID->referenceObject ? disabled}>{$entity->name}</option>
                    </select>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-4"></div>
                <div class="col-sm-8">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="isAbstract" id="isAbstract" value="{$selectedEntity->isAbstract|json}" {$selectedEntity->isAbstract ? checked}>
                        <label class="form-check-label small text-secondary" for="isAbstract">Abstract Entity</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="isAuthorizable" id="isAuthorizable" value="{$selectedEntity->isAuthorizable|json}" {$selectedEntity->isAuthorizable ? checked}>
                        <label class="form-check-label small text-secondary" for="isAuthorizable">Authorizable Entity</label>
                    </div>
                </div>
            </div>
            <div class="inspector-header">Class Generation</div>
            <div class="row mb-2">
                <label for="managedObjectClassName" class="col-sm-4 inspector-label">Class Name</label>
                <div class="col-sm-8">
                    <input type="text" name="managedObjectClassName" id="managedObjectClassName" placeholder="Entity Name" class="form-control form-control-sm text-truncate font-monospace" value="{$selectedEntity->managedObjectClassName}" autocomplete="off" spellcheck="false" style="font-size: 11px;">
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-4 inspector-label">Constraints</div>
                <div class="col-sm-8">
                    <div class="list-control-container">
                        <div class="list-control-content">
                            <table class="list-control-table">
                                <tbody>
                                <tr n:if="$selectedEntity->uniquenessConstraints->isEmpty">
                                    <td class="text-muted fst-italic text-center py-4" style="border: none;">No constraints</td>
                                </tr>
                                <tr n:foreach="$selectedEntity->uniquenessConstraints as $uniquenessConstraint" id="constraint-{$uniquenessConstraint->objectID->referenceObject}" data-href="/Editor?project={$project?->objectID?->referenceObject}&entity={$selectedEntity->objectID->referenceObject}&constraint={$uniquenessConstraint->objectID->referenceObject}" class="cursor-pointer {$uniquenessConstraint->objectID->referenceObject === $selectedUniquenessConstraint?->objectID?->referenceObject ? active}">
                                    <td>
                                        <i class="bi bi-key-fill me-1 opacity-50" style="font-size: 10px;"></i>
                                        {$uniquenessConstraint->stringValue}
                                    </td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="list-control-toolbar">
                            <button type="button" class="btn btn-sm icon" data-bs-toggle="modal" data-bs-target="#addUniquenessConstraint">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                            <button type="button" class="btn btn-sm icon" onclick="remove({$selectedUniquenessConstraint}, register)" {!$selectedUniquenessConstraint instanceof App\Model\UniquenessConstraint ? disabled}>
                                <i class="bi bi-dash-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="inspector-header">Versioning</div>
            <div class="row mb-2">
                <label for="versionHashModifier" class="col-sm-4 inspector-label">Hash Modifier</label>
                <div class="col-sm-8">
                    <input type="text" name="versionHashModifier" id="versionHashModifier" placeholder="Version Hash Modifier" class="form-control form-control-sm text-truncate" value="{$selectedEntity->versionHashModifier}" autocomplete="off" spellcheck="false">
                </div>
            </div>
            <div class="row mb-2">
                <label for="renamingIdentifier" class="col-sm-4 inspector-label">Renaming ID</label>
                <div class="col-sm-8">
                    <input type="text" name="renamingIdentifier" id="renamingIdentifier" placeholder="Renaming Identifier" class="form-control form-control-sm text-truncate" value="{$selectedEntity->renamingIdentifier}" autocomplete="off" spellcheck="false">
                </div>
            </div>
            <input type="hidden" name="X-Http-Method-Override" value="PATCH"> <input class="d-none" type="submit">
        </form>
        <div class="modal fade ide-modal" id="addUniquenessConstraint" tabindex="-1" aria-labelledby="addUniquenessConstraintLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content">
                    <div class="modal-header">
                        <h6 class="modal-title" id="addUniquenessConstraintLabel">Add Uniqueness Constraint</h6>
                    </div>
                    <form id="addUniquenessConstraintForm" action="/UniquenessConstraint" method="POST">
                        <div class="modal-body">
                            <div class="modal-form-field">
                                <label for="stringValue" class="modal-form-label">Attribute</label>
                                <select name="stringValue" id="stringValue" class="form-select" {$selectedEntity->attributes->isEmpty ? disabled} required>
                                    {var $attributeNames = $selectedEntity->attributeNames->dropLast(1)}
                                    <option value="" selected disabled>Select attribute...</option>
                                    <option n:foreach="$attributeNames as $attributeName" value="{$attributeName}" {$selectedEntity->uniquenessConstraints->contains(fn(App\Model\UniquenessConstraint $constraint): bool => $constraint->stringValue === $attributeName) ? disabled}>
                                        {$attributeName}
                                    </option>
                                </select>
                                <div class="modal-help-text">
                                    <i class="bi bi-info-circle-fill"></i>
                                    <div>
                                        Enforces uniqueness for this attribute.
                                        <span class="help-note">Conflicts resolve via merge policy.</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" name="entityPropertyID" value="{$selectedEntity?->objectID?->referenceObject}">
                        <div class="modal-footer">
                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-sm btn-primary" {$selectedEntity->attributes->isEmpty ? disabled}>Add Constraint</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{/define}
