{layout "Layout.latte"}
{varType string $title}
{varType string $companyName}
{varType bool $automaticallyDeleteProjectFolders}
{block title}Preferences - {$title}{/block}
{block content}
    <div id="content" class="container-fluid user-select-none">
        <div class="card border-0 h-100">
            <div class="card-body">
                <form action="/Synchronize" method="POST">
                    <div class="mb-3">
                        <label for="CompanyName" class="form-label">Company Name</label>
                        <input type="text" name="CompanyName" id="CompanyName" placeholder="Company Name" class="form-control" value="{$companyName}" autocomplete="off" required>
                    </div>
                    <div class="form-check mb-3">
                        <label class="form-check-label" for="AutomaticallySaveModel">Automatically save model</label>
                        <input class="form-check-input" type="checkbox" name="AutomaticallySaveModel" id="AutomaticallySaveModel" value="{$automaticallyDeleteProjectFolders}" {$automaticallyDeleteProjectFolders ? checked}>
                    </div>
                    <div class="form-check mb-3">
                        <label class="form-check-label" for="AutomaticallyDeleteProjectFolders">Deleting a project also deletes its folder</label>
                        <input class="form-check-input" type="checkbox" name="AutomaticallyDeleteProjectFolders" id="AutomaticallyDeleteProjectFolders" value="{$automaticallyDeleteProjectFolders}" {$automaticallyDeleteProjectFolders ? checked}>
                    </div>
                    <input class="d-none" type="submit">
                </form>
            </div>
        </div>
    </div>
{/block}
