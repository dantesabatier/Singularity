{layout "Layout.latte"}
{templateType App\ViewControllers\PreferencesController}
{block title}{$title}{/block}
{block head}{/block}
{block content}
    <div id="main" data-view="preferences" class="user-select-none">
        <nav class="navbar sticky-top bg-dark border-bottom border-black p-0 h-navbar">
            <div class="container-fluid justify-content-start">
                <div class="navbar-brand d-flex align-items-center gap-2 mb-0">
                    <img src="/Resources/Images/icon16@1x.png" srcset="/Resources/Images/icon16@2x.png 2x, /Resources/Images/icon16@3x.png 3x" alt="{$title}" class="d-inline-block">
                    <span class="fs-6 fw-medium">{$title}</span>
                </div>
            </div>
        </nav>
        <div class="container-fluid p-0 h-content">
            <div class="row g-0 h-100">
                <div class="col-3 bg-dark-subtle border-end d-flex flex-column h-content">
                    <div class="p-2 overflow-auto flex-grow-1">
                        <h6 class="text-secondary text-uppercase fw-semibold px-2 mb-2 sidebar-header">
                            Settings
                        </h6>
                        <nav class="nav flex-column">
                            <a class="nav-item active" href="#general"><span class="material-symbols-outlined me-2">settings</span><span>General</span></a>
                            <a class="nav-item" href="#projects"><span class="material-symbols-outlined me-2">folder</span><span>Projects</span></a>
                            <a class="nav-item" href="#ai"><span class="material-symbols-outlined me-2">auto_awesome</span><span>AI</span></a>
                        </nav>
                    </div>
                </div>
                <div class="col-9 d-flex flex-column h-content">
                    <div class="overflow-auto flex-grow-1 p-4">
                        <form action="/Synchronize" method="POST" class="needs-validation">
                            <section id="general" class="mb-5">
                                <h5 class="fw-semibold mb-3 pb-2 border-bottom">General</h5>
                                <div class="row mb-4">
                                    <div class="col-md-8">
                                        <label for="companyName" class="form-label d-flex align-items-center gap-2">
                                            <span class="material-symbols-outlined text-muted">business</span> <span>Company Name</span> </label>
                                        <input type="text" name="companyName" id="companyName" placeholder="Enter your company name" class="form-control" value="{$companyName}" autocomplete="off" required>
                                        <small class="form-text text-muted mt-1 d-block"> This name will be used throughout the application </small>
                                    </div>
                                </div>
                            </section>
                            <section id="projects" class="mb-5">
                                <h5 class="fw-semibold mb-3 pb-2 border-bottom">Projects</h5>
                                <div class="card border-0 mb-3">
                                    <div class="card-body p-3">
                                        <div class="d-flex align-items-start gap-3">
                                            <div class="form-check mt-1">
                                                <input class="form-check-input" type="checkbox" name="automaticallyDeleteProjectFolders" id="automaticallyDeleteProjectFolders" value="{$automaticallyDeleteProjectFolders|json}" {$automaticallyDeleteProjectFolders ? 'checked' : ''}>
                                            </div>
                                            <div class="flex-grow-1">
                                                <label class="form-check-label fw-medium mb-1 cursor-pointer" for="automaticallyDeleteProjectFolders"> Delete project folders automatically </label>
                                                <p class="text-muted small mb-0">
                                                    When enabled, deleting a project will also remove its folder from the disk.
                                                    <span class="text-warning">This action cannot be undone.</span>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="alert alert-warning border-0 d-flex align-items-start gap-2" role="alert">
                                    <span class="material-symbols-outlined ms-filled mt-1">warning</span>
                                    <div>
                                        <strong>Warning:</strong> Enabling this option will permanently delete project files from your system when removing a project.
                                    </div>
                                </div>
                            </section>
                            <section id="ai" class="mb-5">
                                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                    <h5 class="fw-semibold mb-0">AI</h5>
                                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addLLMProvider">
                                        <span class="material-symbols-outlined me-1">add</span> Add Provider
                                    </button>
                                </div>
                                <div id="providers-list" class="d-flex flex-column gap-2 mb-3">
                                    {foreach $aiProviders as $provider}
                                        <div class="card border-0 provider-card" data-provider="{$provider->dictionaryRepresentation|json}">
                                            <div class="card-body p-3">
                                                <div class="d-flex align-items-start justify-content-between gap-2">
                                                    <div class="d-flex align-items-center gap-2 min-w-0">
                                                        <span class="ai-provider-icon tier-{$provider->identifier}" style="flex-shrink:0">{$provider->name|first}</span>
                                                        <div class="min-w-0">
                                                            <div class="fw-medium">{$provider->name}</div>
                                                            <small class="text-muted text-truncate d-block">{$provider->url}</small>
                                                        </div>
                                                    </div>
                                                    <div class="d-flex gap-1 flex-shrink-0">
                                                        <button type="button" class="btn btn-sm btn-icon" data-ai-action="editProvider" title="Edit">
                                                            <span class="material-symbols-outlined">edit</span>
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-icon text-danger" data-ai-action="deleteProvider" title="Delete">
                                                            <span class="material-symbols-outlined">delete</span>
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="mt-2 d-flex flex-column gap-1 ps-1">
                                                    {foreach $provider->models as $model}
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="ai-model-item-dot tier-{$model->tier}"></span>
                                                            <span class="small">{$model->name}</span>
                                                            <code class="ai-model-item-id">{$model->identifier}</code>
                                                            <span n:if="$editorAIModel === $model->identifier" class="material-symbols-outlined ms-filled text-success ms-auto">check_circle</span>
                                                        </div>
                                                    {/foreach}
                                                </div>
                                            </div>
                                        </div>
                                    {/foreach}
                                </div>
                                <div class="modal fade ide-modal" id="addLLMProvider" tabindex="-1" aria-labelledby="addLLMProviderLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h6 class="modal-title" id="addLLMProviderLabel">Provider</h6>
                                            </div>
                                            <div class="modal-body">
                                                <div class="modal-form-field">
                                                    <label for="pf-name" class="modal-form-label">Name</label>
                                                    <input type="text" id="pf-name" class="form-control" placeholder="e.g. Anthropic" autocomplete="off">
                                                </div>
                                                <div class="modal-form-field">
                                                    <label for="pf-identifier" class="modal-form-label">Identifier</label>
                                                    <input type="text" id="pf-identifier" class="form-control" placeholder="e.g. anthropic" autocomplete="off">
                                                </div>
                                                <div class="modal-form-field">
                                                    <label for="pf-url" class="modal-form-label">URL</label>
                                                    <input type="url" id="pf-url" class="form-control" placeholder="https://api.example.com/v1/messages" autocomplete="off">
                                                </div>
                                                <div class="modal-form-field">
                                                    <label for="pf-apiKey" class="modal-form-label">API Key</label>
                                                    <input type="password" id="pf-apiKey" class="form-control" placeholder="sk-…" autocomplete="off">
                                                </div>
                                                <div class="modal-form-field">
                                                    <label class="modal-form-label">Models</label>
                                                    <div id="pf-models-list" class="d-flex flex-column gap-1 mb-2"></div>
                                                    <div class="d-flex gap-2 align-items-center">
                                                        <input name="name" aria-label="name" type="text" id="pf-model-name" class="form-control form-control-sm" placeholder="Name (e.g. Opus 4.8)" autocomplete="off">
                                                        <input name="identifier" aria-label="identifier" type="text" id="pf-model-id" class="form-control form-control-sm" placeholder="Identifier" autocomplete="off">
                                                        <input name="tier" aria-label="ter" type="text" id="pf-model-tier" class="form-control form-control-sm" placeholder="Tier" style="min-width: 80px;" autocomplete="off">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary flex-shrink-0" data-ai-action="addModel">
                                                            <span class="material-symbols-outlined">add</span>
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="modal-form-field">
                                                    <label class="modal-form-label">Generation options</label>
                                                    <div id="pf-options-list" class="d-flex flex-column gap-1 mb-2"></div>
                                                    <div class="d-flex gap-2 align-items-center">
                                                        <input name="optionKey" aria-label="option key" type="text" id="pf-option-key" class="form-control form-control-sm" placeholder="Key (e.g. num_ctx)" autocomplete="off">
                                                        <input name="optionValue" aria-label="option value" type="text" id="pf-option-value" class="form-control form-control-sm" placeholder="Value (e.g. 16384)" autocomplete="off">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary flex-shrink-0" data-ai-action="addOption">
                                                            <span class="material-symbols-outlined">add</span>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="button" id="pf-confirm-btn" class="btn btn-sm btn-primary" data-ai-action="confirmAddProvider">Add Provider</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>
                            <input class="d-none" type="submit">
                        </form>
                        <div class="mt-5 pt-4 border-top">
                            <small class="text-muted d-flex align-items-center gap-2"> <span class="material-symbols-outlined">info</span><span>Changes are saved automatically</span>
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{/block}
{block scripts}{/block}
