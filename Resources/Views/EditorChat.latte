{templateType App\ViewControllers\EditorController}
{define editorChat}
    <div id="ai-chat-panel" class="ai-chat-panel" data-project-object-id="{$project->objectID|json}" data-ai-provider="{$selectedLLMProviderIdentifier ?? 'anthropic'}" data-ai-model="{$selectedAIModel ?? 'claude-opus-4-7'}">
        <div class="ai-chat-header">
            <div class="dropdown">
                <button class="btn btn-icon ai-chat-icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Conversations">
                    <i class="bi bi-clock-history"></i>
                </button>
                <ul class="dropdown-menu">
                    <li><h6 class="dropdown-header">Conversations</h6></li>
                    {if $project->conversations->isEmpty}
                        <li><span class="dropdown-item text-muted fst-italic pe-none">No conversations</span></li>
                    {else}
                        {foreach $project->conversations as $conversation}
                            {if !$conversation->title}
                                {continueIf true}
                            {/if}
                            <li class="d-flex align-items-center pe-1">
                                <button class="dropdown-item d-flex align-items-center gap-2 flex-grow-1" type="button" data-editor-action="selectConversation" data-conversation-id="{$conversation->objectID|json}">
                                    <i class="bi bi-chat-text" style="flex-shrink: 0;"></i>
                                    <span class="text-truncate flex-grow-1">{$conversation->title}</span>
                                    <i n:if="$conversation->isEqual($selectedConversation)" class="bi bi-check ms-1" style="flex-shrink: 0;"></i>
                                </button>
                                <button class="btn btn-sm btn-icon text-danger flex-shrink-0" type="button" data-editor-action="deleteConversation" data-conversation-id="{$conversation->objectID|json}">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </li>
                        {/foreach}
                    {/if}
                </ul>
            </div>
            <span class="ai-chat-title text-truncate flex-grow-1">{$selectedConversation?->title ?? ""}</span>
            <div class="dropdown">
                <button class="btn ai-model-picker-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Select AI Model" id="chat-model-picker-btn">
                    <span class="ai-model-indicator" id="chat-model-indicator"></span>
                    <span class="ai-model-name" id="chat-model-name">Opus 4.7</span>
                    <i class="bi bi-chevron-down" style="font-size: 8px; opacity: 0.5;"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end ai-model-dropdown">
                    {foreach $aiProviders as $provider}
                        <li>
                            <h6 class="dropdown-header ai-provider-header">
                                <span class="ai-provider-icon tier-{$provider->identifier}">{$provider->name|first}</span>
                                {$provider->name}
                            </h6>
                        </li>
                        {foreach $provider->models as $model}
                            <li>
                                <button class="dropdown-item ai-model-item" type="button" data-provider="{$provider->identifier}" data-model="{$model->identifier}" data-label="{$model->name}" data-tier="{$model->tier}">
                                    <span class="ai-model-item-dot tier-{$model->tier}"></span>
                                    <span class="ai-model-item-name">{$model->name}</span>
                                    <code class="ai-model-item-id">{$model->identifier}</code>
                                </button>
                            </li>
                        {/foreach}
                        {if !$iterator->last}
                            <li>
                                <hr class="dropdown-divider">
                            </li>{/if}
                    {/foreach}
                </ul>
            </div>
            <span id="ai-status" class="ai-status-pill is-idle">Idle</span>
        </div>
        <div n:if="!$selectedConversation" class="ai-chat-empty flex-grow-1">
            <i class="bi bi-stars"></i>
            <p>Select a conversation or start typing below</p>
        </div>
        <div n:if="$selectedConversation" id="chat-messages" data-conversation-id="{$selectedConversation->objectID|json}" class="ai-chat-messages flex-grow-1">
            {foreach $selectedConversation->messages as $message}
                <div class="ai-msg ai-msg--{$message->role}">
                    <div n:if="$message->role !== 'tool'" class="ai-bubble">{$message->content}</div>
                    <div n:if="$message->role === 'tool'" class="ai-tool-badge">
                        <i class="bi bi-check2-circle"></i>
                        {$message->toolCallId}
                    </div>
                    <div n:if="$message->role === 'assistant'"
                         n:foreach="json_decode($message->toolCalls ?? '[]', true) ?? [] as $tc"
                            class="ai-tool-badge">
                        <i class="bi bi-gear"></i> {$tc["name"]}
                    </div>
                </div>
            {/foreach}
            <div id="chat-thinking" class="ai-thinking">
                <span></span><span></span><span></span>
            </div>
        </div>
        <div class="ai-chat-input-bar flex-shrink-0">
            <textarea aria-label="chat" id="chat-input" class="ai-chat-textarea" rows="2" placeholder="Ask the AI…"></textarea>
            <button type="button" id="chat-send-btn" class="ai-send-btn" disabled>
                <i class="bi bi-arrow-up"></i>
            </button>
        </div>
    </div>
{/define}
