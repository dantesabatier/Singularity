{templateType App\ViewControllers\EditorController}
{define editorChat}
    <div id="ai-chat-panel" class="ai-copilot-panel" data-project-object-id="{$project->objectID|json}" style="display: flex; flex-direction: column; height: 100%;">
        <div class="inspector-header ai-copilot-header d-flex align-items-center gap-2 flex-shrink-0">
            <div class="dropdown">
                <button class="btn btn-icon px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Conversations">
                    <i class="bi bi-clock-history"></i>
                </button>
                <ul class="dropdown-menu">
                    <li><h6 class="dropdown-header">Conversations</h6></li>
                    {foreach $project->conversations as $conversation}
                        <li>
                            <button class="dropdown-item d-flex align-items-center gap-2" type="button" data-editor-action="selectConversation" data-conversation-id="{$conversation->objectID|json}">
                                <i class="bi bi-chat-text" style="flex-shrink: 0;"></i>
                                <span class="text-truncate flex-grow-1">{$conversation->title}</span>
                                <i n:if="$selectedConversation?->objectID === $conversation->objectID" class="bi bi-check ms-1" style="flex-shrink: 0;"></i>
                            </button>
                        </li>
                    {/foreach}
                </ul>
            </div>
            <span class="text-truncate flex-grow-1" style="font-size: 11px; color: var(--text-secondary);">{$selectedConversation?->title ?? ""}</span>
            <span id="ai-status" class="ai-copilot-status is-idle flex-shrink-0">Idle</span>
        </div>
        <div n:if="!$selectedConversation" class="chat-empty-state flex-grow-1">
            <i class="bi bi-chat-left-dots"></i>
            <p>Select a conversation<br>from the dropdown above</p>
        </div>
        <div n:if="$selectedConversation" id="chat-messages" data-conversation-id="{$selectedConversation->objectID|json}" class="flex-grow-1 overflow-auto p-2 d-flex flex-column gap-2" style="min-height: 0;">
            <div n:foreach="$selectedConversation->messages as $message" class="chat-message chat-message--{$message->role}">
                <div n:if="$message->role !== 'tool'" class="chat-bubble">{$message->content}</div>
                <div n:if="$message->role === 'tool'" class="chat-tool-badge">
                    <i class="bi bi-gear-fill"></i> {$message->toolCallId}
                </div>
                <div n:if="$message->role === 'assistant'" n:foreach="json_decode($message->toolCalls ?? '[]', true) ?? [] as $tc" class="chat-tool-badge mt-1">
                    <i class="bi bi-gear"></i> {$tc["name"]}
                </div>
            </div>
            <div id="chat-thinking" class="chat-thinking">
                <span></span><span></span><span></span>
            </div>
        </div>
        <div class="flex-shrink-0 p-2 d-flex gap-2 align-items-end" style="border-top: 1px solid var(--border-color);">
            <textarea aria-label="chat" id="chat-input" class="form-control form-control-sm" rows="2" placeholder="Ask the AI…" style="resize: none; font-size: 12px;"></textarea>
            <button type="button" id="chat-send-btn" class="btn btn-primary btn-sm" disabled>
                <i class="bi bi-send"></i>
            </button>
        </div>
    </div>
{/define}
