{templateType App\ViewControllers\EditorController}
{define graphView}
    <div id="graph-view-container" class="graph-view-container">
        <div class="graph-toolbar">
            <div class="graph-toolbar-section">
                <button class="btn btn-icon" id="graph-zoom-in" data-graph-action="zoomIn" data-bs-toggle="tooltip" data-bs-title="Zoom In">
                    <span class="material-symbols-outlined">zoom_in</span>
                </button>
                <button class="btn btn-icon" id="graph-zoom-out" data-graph-action="zoomOut" data-bs-toggle="tooltip" data-bs-title="Zoom Out">
                    <span class="material-symbols-outlined">zoom_out</span>
                </button>
                <button class="btn btn-icon" id="graph-fit" data-graph-action="fit" data-bs-toggle="tooltip" data-bs-title="Fit to Screen">
                    <span class="material-symbols-outlined">fullscreen</span>
                </button>
                <button class="btn btn-icon" id="graph-center" data-graph-action="center" data-bs-toggle="tooltip" data-bs-title="Center View">
                    <span class="material-symbols-outlined">my_location</span>
                </button>
            </div>
            <div class="graph-toolbar-divider"></div>
            <div class="graph-toolbar-section">
                <button class="btn btn-icon" id="graph-layout" data-graph-action="layout" data-bs-toggle="tooltip" data-bs-title="Auto Layout">
                    <span class="material-symbols-outlined">account_tree</span>
                </button>
            </div>
            <div class="graph-toolbar-divider"></div>
            <div class="graph-toolbar-section">
                <span class="graph-toolbar-label">Zoom: <span id="graph-zoom-level">100%</span></span>
            </div>
        </div>
        <div id="graph-canvas"></div>
        <div id="graph-empty-state" class="graph-empty-state" style="display: none;">
            <span class="material-symbols-outlined">account_tree</span>
            <h3>No Entities Found</h3>
            <p>Add entities to your model to see them visualized here</p>
        </div>
    </div>
{/define}
