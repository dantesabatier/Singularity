{templateType App\ViewControllers\EditorController}
{define compositeTypeElements}
    <div class="ide-list-control">
        <!-- Header -->
        <div class="list-control-header">
            <span class="list-control-title">Attributes</span>
        </div>

        <!-- Table -->
        <div class="list-control-content">
            <table class="list-control-table">
                <thead>
                <tr>
                    <th class="col-name">Name</th>
                    <th class="col-type">Type</th>
                    <th class="col-flex"></th>
                </tr>
                </thead>
                <tbody>
                <tr n:foreach="$selectedCompositeType->elements as $element"
                        id="property-{$element->objectID->referenceObject}"
                        data-href="/Editor?project={$project?->objectID?->referenceObject}&composite={$selectedCompositeType->objectID->referenceObject}&property={$element->objectID->referenceObject}"
                        n:class="$element->objectID->referenceObject === $selectedProperty?->objectID?->referenceObject ? active">

                    <!-- Name Column -->
                    <td class="col-name">
                        <div class="cell-content">
                            {var string $img = img($element)}
                            <img class="cell-icon" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">
                            <span class="cell-text">{$element->name}</span>
                        </div>
                    </td>

                    <!-- Type Column -->
                    <td class="col-type">
                        <form action="/Attribute" method="POST" class="cell-form">
                            <input type="hidden" name="X-Http-Method-Override" value="PATCH">
                            <input type="hidden" name="objectID" value="{$element->objectID->referenceObject}">
                            <select name="type" aria-label="Type" class="form-select transparent" data-autosave="true">
                                <option n:foreach="$attributeTypes as $attributeType"
                                        value="{$attributeType->value}"
                                        {$attributeType->value === $element->type->value ? selected}>
                                    {$attributeType->name}
                                </option>
                            </select>
                        </form>
                    </td>

                    <!-- Empty Column -->
                    <td class="col-flex"></td>
                </tr>
                </tbody>
            </table>
        </div>

        <!-- Toolbar -->
        <div class="list-control-toolbar">
            <button class="btn btn-icon"
                    title="Add Attribute"
                    onclick="add({App\Model\Attribute::entity()->name}, {App\Model\Attribute::entity()->name|firstLower}, {$selectedCompositeType}, {$selectedCompositeType?->elements?->count}, register)">
                <i class="bi bi-plus-lg"></i>
            </button>
            <button class="btn btn-icon"
                    title="Remove Attribute"
                    onclick="remove({$selectedProperty}, register)"
                    {!$selectedProperty instanceof App\Model\Attribute ? disabled}>
                <i class="bi bi-dash-lg"></i>
            </button>
        </div>
    </div>
{/define}
