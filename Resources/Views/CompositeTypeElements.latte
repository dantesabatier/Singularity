{templateType App\ViewControllers\Editor}
{varType Sabatier\Foundation\Set $elements}
{define compositeTypeElements, $elements}
    <div class="table-responsive">
        <table class="table table-hover table-sm caption-top">
            <caption class="fw-bold text-shadow">Attributes</caption>
            <thead>
            <tr>
                <th scope="col" class="col-sm-2 text-shadow">Name</th>
                <th scope="col" class="col-sm-2 text-shadow">Type</th>
                <th scope="col" class="col-sm-8 text-shadow"></th>
            </tr>
            </thead>
            <tbody>
            <tr n:foreach="$elements as $element" id="property-{$element->objectID->referenceObject}" data-href="/Editor?project={$project?->objectID?->referenceObject}&composite={$selectedCompositeType->objectID->referenceObject}&property={$element->objectID->referenceObject}" n:class="$element->objectID->referenceObject === $selectedProperty?->objectID?->referenceObject ? table-active">
                {var string $img = img($element)}
                <td class="text-truncate">
                    <img class="ps-2" src="/Resources/Images/{$img}@1x.png" srcset="/Resources/Images/{$img}@2x.png 2x, /Resources/Images/{$img}@3x.png 3x" alt="">
                    {$element->name}
                </td>
                <td>
                    <form action="/Attribute" method="POST">
                        <input type="hidden" name="X-Http-Method-Override" value="PATCH">
                        <input type="hidden" name="objectID" value="{$element->objectID->referenceObject}">
                        {var array $types = [0 => "Undefined", 100 => "Integer 16", 200 => "Integer 32", 300 => "Integer 64", 400 => "Decimal", 500 => "Double", 600 => "Float", 700 => "String", 800 => "Boolean", 900 => "Date", 1000 => "Binary Data", 1100 => "UUID", 1200 => "URI", 1800 => "Transformable"]}
                        <select name="type" id="type" class="form-select form-select-sm transparent border-0 py-0 w-auto" aria-label="Type" data-autosave="true">
                            <option n:foreach="$types as $key => $value" value="{$key}" {$key === $element->type->value ? selected}>
                                {$value}
                            </option>
                        </select>
                    </form>
                </td>
                <td></td>
            </tr>
            </tbody>
            <tfoot>
            <tr>
                <td>
                    <div class="d-inline-block">
                        <button class="btn icon p-0" onclick="add({App\Model\Attribute::entity()->name}, {App\Model\Attribute::entity()->name|firstLower}, {$selectedCompositeType}, register)">
                            <i class="bi bi-plus"></i>
                        </button>
                        <button class="btn icon p-0" onclick="remove({$selectedProperty}, register)" {!$selectedProperty instanceof App\Model\Attribute ? disabled}>
                            <i class="bi bi-dash"></i>
                        </button>
                    </div>
                </td>
                <td></td>
                <td></td>
            </tr>
            </tfoot>
        </table>
    </div>
{/define}
