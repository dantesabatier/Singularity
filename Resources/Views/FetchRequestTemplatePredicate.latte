{varType App\Model\FetchRequestTemplate $selectedFetchRequestTemplate}
{define fetchRequestTemplatePredicate}
    <form action="/FetchRequestTemplate" method="POST">
        <div class="my-2 fs-6 fw-bold text-shadow">
            {$selectedFetchRequestTemplate->name}
        </div>
        <div class="mb-3">
            <label for="predicateString" class="form-label">Predicate</label>
            <input type="text" name="predicateString" id="predicateString" placeholder="Predicate" class="form-control text-truncate" value="{$selectedFetchRequestTemplate->predicateString}" autocomplete="off" spellcheck="false">
        </div>
        <input type="hidden" name="objectID" value="{$selectedFetchRequestTemplate->objectID->referenceObject}">
        <input type="hidden" name="X-Http-Method-Override" value="PATCH">
        <input class="d-none" type="submit">
    </form>
{/define}
