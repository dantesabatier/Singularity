{define fetchRequestTemplatePredicate}
    {varType App\Model\FetchRequestTemplate $selectedFetchRequestTemplate}

    <div class="content-panel">
        <div class="content-panel-header">
            <div class="content-panel-title">
                <span class="material-symbols-outlined">search</span> <span>{$selectedFetchRequestTemplate->name}</span>
            </div>
            <span class="content-panel-badge">TEMPLATE</span>
        </div>

        <form action="/FetchRequestTemplate" method="POST" class="content-panel-body">
            <div class="form-section">
                <div class="form-section-header">
                    <label for="predicateString" class="form-section-label">Predicate Format</label>
                    <div class="popover-anchor">
                        <button type="button" class="form-section-help" id="syntax-help-btn" data-popover="syntax-help-pop" aria-expanded="false">
                            <span class="material-symbols-outlined">help</span> <span>Syntax Help</span>
                        </button>
                        <div class="ide-popover" id="syntax-help-pop" aria-hidden="true">
                            <div class="ide-popover-header">
                                <span class="ide-popover-title">NSPredicate Syntax</span>
                                <button type="button" class="ide-popover-close" data-popover-close="syntax-help-pop">✕</button>
                            </div>
                            <div class="ide-popover-body">
                                <div class="sp-group">
                                    <div class="sp-group-title">Comparison Operators</div>
                                    <div class="sp-row">
                                        <span class="sp-label">Equal</span><code class="sp-chip" data-copy="==">&nbsp;==&nbsp;</code>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">Not equal</span><code class="sp-chip" data-copy="!=">&nbsp;!=&nbsp;</code>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">Greater than</span><code class="sp-chip" data-copy=">">&nbsp;&gt;&nbsp;</code>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">Less than</span><code class="sp-chip" data-copy="<">&nbsp;&lt;&nbsp;</code>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">Greater or equal</span><code class="sp-chip" data-copy=">=">&nbsp;&gt;=&nbsp;</code>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">Less or equal</span><code class="sp-chip" data-copy="<=">&nbsp;&lt;=&nbsp;</code>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">In collection</span><code class="sp-chip" data-copy="IN">&nbsp;IN&nbsp;</code>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">Inclusive range</span><code class="sp-chip" data-copy="BETWEEN {l}$LOWER, $UPPER{r}">&nbsp;BETWEEN&nbsp;</code>
                                    </div>
                                </div>
                                <div class="sp-divider"></div>
                                <div class="sp-group">
                                    <div class="sp-group-title">Compound Predicates</div>
                                    <div class="sp-row">
                                        <span class="sp-label">Logical AND</span><code class="sp-chip" data-copy="AND">&nbsp;AND&nbsp;</code><span class="sp-alias">&amp;&amp;</span>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">Logical OR</span><code class="sp-chip" data-copy="OR">&nbsp;OR&nbsp;</code><span class="sp-alias">||</span>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">Logical NOT</span><code class="sp-chip" data-copy="NOT">&nbsp;NOT&nbsp;</code><span class="sp-alias">!</span>
                                    </div>
                                </div>
                                <div class="sp-divider"></div>
                                <div class="sp-group">
                                    <div class="sp-group-title">String Operators</div>
                                    <div class="sp-row">
                                        <span class="sp-label">Contains substring</span><code class="sp-chip" data-copy="CONTAINS">&nbsp;CONTAINS&nbsp;</code>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">Starts with</span><code class="sp-chip" data-copy="BEGINSWITH">&nbsp;BEGINSWITH&nbsp;</code>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">Ends with</span><code class="sp-chip" data-copy="ENDSWITH">&nbsp;ENDSWITH&nbsp;</code>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">Wildcard — ? one, * any</span><code class="sp-chip" data-copy="LIKE">&nbsp;LIKE&nbsp;</code>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">Regular expression</span><code class="sp-chip" data-copy="MATCHES">&nbsp;MATCHES&nbsp;</code>
                                    </div>
                                    <div class="sp-modifier-note">
                                        Case and diacritic sensitive by default.<br> Append <code>[c]</code> or
                                        <code>[cd]</code> — e.g. <code>CONTAINS[cd]</code>
                                    </div>
                                </div>
                                <div class="sp-divider"></div>
                                <div class="sp-group">
                                    <div class="sp-group-title">Aggregate</div>
                                    <div class="sp-row">
                                        <span class="sp-label">At least one matches</span><code class="sp-chip" data-copy="ANY ">&nbsp;ANY&nbsp;</code><span class="sp-alias">SOME</span>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">All elements match</span><code class="sp-chip" data-copy="ALL ">&nbsp;ALL&nbsp;</code>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">No element matches</span><code class="sp-chip" data-copy="NONE ">&nbsp;NONE&nbsp;</code>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">Filter, chain .@count</span><code class="sp-chip" data-copy="SUBQUERY(collection, $item, predicate)">&nbsp;SUBQUERY&nbsp;</code>
                                    </div>
                                </div>
                                <div class="sp-divider"></div>
                                <div class="sp-group">
                                    <div class="sp-group-title">Values</div>
                                    <div class="sp-row">
                                        <span class="sp-label">Substitution variable</span><code class="sp-chip" data-copy="$VARIABLE">&nbsp;$VARIABLE&nbsp;</code>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">Null</span><code class="sp-chip" data-copy="nil">&nbsp;nil&nbsp;</code>
                                    </div>
                                    <div class="sp-row">
                                        <span class="sp-label">Self</span><code class="sp-chip" data-copy="SELF">&nbsp;SELF&nbsp;</code>
                                    </div>
                                    <div class="sp-modifier-note">
                                        In a template, use <code>$VARIABLE</code> for runtime values. The format
                                        placeholders <code>%K</code> and <code>%@</code> are filled from arguments
                                        when a predicate is built in code, not in a saved template.
                                    </div>
                                </div>
                                <div class="sp-divider"></div>
                                <div class="sp-group">
                                    <div class="sp-group-title">Examples</div>
                                    <div class="sp-example" data-copy="name == $NAME AND status == 1">name ==
                                        <b>$NAME</b> AND status == 1
                                    </div>
                                    <div class="sp-example" data-copy="email CONTAINS[cd] $QUERY">email CONTAINS[cd]
                                        <b>$QUERY</b></div>
                                    <div class="sp-example" data-copy="date >= $START AND date < $END">date &gt;=
                                        <b>$START</b> AND date &lt; <b>$END</b></div>
                                    <div class="sp-example" data-copy="amount BETWEEN {l}$MIN, $MAX{r}">amount BETWEEN {l}
                                        <b>$MIN</b>, <b>$MAX</b>{r}</div>
                                    <div class="sp-example" data-copy="ANY tags.name IN {l}$TAG1, $TAG2{r}">ANY tags.name IN {l}
                                        <b>$TAG1</b>, <b>$TAG2</b>{r}</div>
                                    <div class="sp-example" data-copy="SUBQUERY(items, $x, $x.price > $MIN).@count > 0">SUBQUERY(items,
                                        <b>$x</b>, <b>$x</b>.price &gt; <b>$MIN</b>).@count &gt; 0
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <textarea name="predicateString" id="predicateString" class="form-control code-editor" rows="5" autocomplete="off" spellcheck="false" placeholder="name == $NAME AND date > $DATE" required>{$selectedFetchRequestTemplate->predicateString}</textarea>
                <!-- Help Text -->
                <div class="form-help-text">
                    <span class="material-symbols-outlined ms-filled">info</span>
                    <div class="form-help-content">
                        <div>Use <code class="inline-code">$VARIABLE</code> for substitution variables.</div>
                        <div class="form-help-note">Key paths are supported — e.g., address.city == $CITY.</div>
                    </div>
                </div>
            </div>

            <input type="hidden" name="objectID" value="{$selectedFetchRequestTemplate->objectID|json}">
            <input type="hidden" name="X-Http-Method-Override" value="PATCH"> <input class="d-none" type="submit">
        </form>
    </div>
{/define}
