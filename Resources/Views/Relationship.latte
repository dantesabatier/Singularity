{templateType App\ViewControllers\EditorController}
{varType App\Model\Relationship $selectedProperty}
{define relationship}
    <div class="px-3 pb-4">
        <form action="/Relationship" method="POST">
            <input type="hidden" name="objectID" value="{$selectedProperty->objectID->referenceObject}">

            <div class="inspector-header">Relationship</div>

            <div class="row mb-2">
                <label for="name" class="col-sm-4 inspector-label">Name</label>
                <div class="col-sm-8">
                    <input type="text" name="name" id="name" placeholder="Relationship Name" class="form-control form-control-sm text-truncate fw-bold" value="{$selectedProperty->name}" autocomplete="off" spellcheck="false" required>
                </div>
            </div>

            <div class="row mb-2">
                <div class="col-sm-4"></div>
                <div class="col-sm-8">
                    <div class="d-flex flex-column gap-1">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="isOptional" value="{$selectedProperty->isOptional|json}" id="isOptional" {$selectedProperty->isOptional ? checked}>
                            <label class="form-check-label small text-secondary" for="isOptional">Optional</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="isTransient" value="{$selectedProperty->isTransient|json}" id="isTransient" {$selectedProperty->isTransient ? checked}>
                            <label class="form-check-label small text-secondary" for="isTransient">Transient</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="inspector-header">Destination</div>

            <div class="row mb-2">
                <label for="lazyDestinationEntityName" class="col-sm-4 inspector-label">Entity</label>
                <div class="col-sm-8">
                    <select name="lazyDestinationEntityName" id="lazyDestinationEntityName" class="form-select form-select-sm" data-autosave="true">
                        <option value="">No Destination</option>
                        <option disabled>──────────</option>
                        <option n:foreach="$project->model->entities as $entity" value="{$entity->name}" {$entity->name === $selectedProperty->lazyDestinationEntityName ? selected}>{$entity->name}</option>
                    </select>
                </div>
            </div>

            <div class="row mb-2">
                <label for="lazyInverseRelationshipName" class="col-sm-4 inspector-label">Inverse</label>
                <div class="col-sm-8">
                    <select name="lazyInverseRelationshipName" id="lazyInverseRelationshipName" class="form-select form-select-sm" data-autosave="true">
                        <option value="">No Inverse</option>
                        <option disabled>──────────</option>
                        {var ?App\Model\Entity $destinationEntity = $selectedProperty->destinationEntity}
                        {if $destinationEntity}
                            <option n:foreach="$destinationEntity->relationships as $relationship" value="{$relationship->name}" {$relationship->name === $selectedProperty->lazyInverseRelationshipName ? selected}>{$relationship->name}</option>
                        {/if}
                    </select>
                </div>
            </div>

            <div class="inspector-header">Configuration</div>

            <div class="row mb-2">
                <label for="deleteRule" class="col-sm-4 inspector-label">Delete Rule</label>
                <div class="col-sm-8">
                    <select name="deleteRule" id="deleteRule" class="form-select form-select-sm" data-autosave="true">
                        <option n:foreach="$deleteRules as $deleteRule" value="{$deleteRule->value}" {$deleteRule->value === $selectedProperty->deleteRule->value ? selected}>{$deleteRule->name}</option>
                    </select>
                </div>
            </div>

            <div class="row mb-2">
                <label for="isToMany" class="col-sm-4 inspector-label">Type</label>
                <div class="col-sm-8">
                    <select name="isToMany" id="isToMany" class="form-select form-select-sm" data-autosave="true">
                        {var array $options = [0 => "To One", 1 => "To Many"]}
                        <option n:foreach="$options as $key => $option" value="{$key}" {$key == $selectedProperty->isToMany ? selected}>{$option}</option>
                    </select>
                </div>
            </div>

            {if $selectedProperty->isToMany}
                <div class="row mb-2">
                    <div class="col-sm-4"></div>
                    <div class="col-sm-8">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="isOrdered" value="{$selectedProperty->isOrdered|json}" id="isOrdered" {$selectedProperty->isOrdered ? checked}>
                            <label class="form-check-label small text-secondary" for="isOrdered">Ordered</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-1">
                    <div class="col-sm-4 inspector-label">Count</div>
                    <div class="col-sm-8">
                        <div class="mb-1">
                            <div class="input-group input-group-sm">
                                <div class="input-group-text bg-transparent border-end-0 px-1">
                                    <input class="form-check-input mt-0" type="checkbox" name="isMinCountBounded" value="{$selectedProperty->isMinCountBounded|json}" id="isMinCountBounded" {$selectedProperty->isMinCountBounded ? checked} aria-label="Enable Minimum Count">
                                </div>
                                <input type="number" name="minCount" id="minCount" class="form-control form-control-sm border-start-0" value="{$selectedProperty->minCount}" {!$selectedProperty->isMinCountBounded ? disabled} placeholder="Min Count" aria-label="Minimum Count">
                            </div>
                        </div>
                        <div>
                            <div class="input-group input-group-sm">
                                <div class="input-group-text bg-transparent border-end-0 px-1">
                                    <input class="form-check-input mt-0" type="checkbox" name="isMaxCountBounded" value="{$selectedProperty->isMaxCountBounded|json}" id="isMaxCountBounded" {$selectedProperty->isMaxCountBounded ? checked} aria-label="Enable Maximum Count">
                                </div>
                                <input type="number" name="maxValue" id="maxValue" class="form-control form-control-sm border-start-0" value="{$selectedProperty->maxValue}" {!$selectedProperty->isMaxCountBounded ? disabled} placeholder="Max Count" aria-label="Maximum Count">
                            </div>
                        </div>
                    </div>
                </div>
            {/if}

            <input type="hidden" name="X-Http-Method-Override" value="PATCH">
            <input class="d-none" type="submit">
        </form>
    </div>
{/define}
