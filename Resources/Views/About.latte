{layout "Layout.latte"}
{templateType App\ViewControllers\AboutController}
{block head}
    <link rel="stylesheet" href="/Resources/Styles/About.css">
{/block}
{block content}
    <div id="main" class="vh-100 d-flex flex-column user-select-none">
        <div class="navbar sticky-top border-bottom p-0">
            <div class="container-fluid px-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <img src="/Resources/Images/icon16@1x.png" srcset="/Resources/Images/icon16@2x.png 2x, /Resources/Images/icon16@3x.png 3x" alt="{$title}" class="d-inline-block">
                    <span class="fs-6 fw-medium">{$title}</span>
                </div>
                <button class="btn btn-icon p-1" data-about-action="close" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Close (ESC)">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
        <div class="container-fluid flex-grow-1 d-flex flex-column justify-content-center align-items-center text-center px-4">
            <div class="mb-4 position-relative">
                <div class="icon-glow"></div>
                <img src="/Resources/Images/icon64@1x.png" srcset="/Resources/Images/icon64@2x.png 2x, /Resources/Images/icon64@3x.png 3x" alt="{$title}" class="app-icon" title="Click me 5 times 😉">
            </div>
            <div class="mb-4">
                <h2 class="fw-bold mb-2">
                    {$bundleName}
                </h2>
                <div class="d-flex align-items-center justify-content-center gap-3 mb-2">
                    <span class="badge bg-primary px-3 py-2" style="font-size: 13px;">
                        Version {$bundleShortVersion}
                    </span> <span class="badge badge-secondary px-3 py-2" style="font-size: 13px;">
                        Build {$bundleVersion}
                    </span>
                </div>
            </div>
            <div class="text-center" style="max-width: 400px;">
                <p class="text-muted mb-3 text-break">
                    {$bundleHumanReadableCopyright}
                </p>
                <div class="d-flex justify-content-center gap-2 mt-4 flex-wrap">
                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2" data-about-action="openURL" data-about-url="{$websiteURL}">
                        <i class="bi bi-globe"></i> <span>Website</span>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2" data-about-action="openURL" data-about-url="{$githubURL}">
                        <i class="bi bi-github"></i> <span>GitHub</span>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2" data-about-action="openURL" data-about-url="{$licenseURL}">
                        <i class="bi bi-file-text"></i> <span>Licenses</span>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2" data-about-action="copyVersionInfo" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Copy version info">
                        <i class="bi bi-clipboard"></i> <span>Copy Info</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="footer border-top py-2 px-3 text-center">
            <small class="text-muted d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-info-circle"></i> <span>Powered by Electron & PHP</span> </small>
        </div>
    </div>
{/block}

{block scripts}
    <script src="/Resources/Scripts/About.js"></script>
{/block}
