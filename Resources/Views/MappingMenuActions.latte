{templateType App\ViewControllers\MappingController}
{define menuActions}
    <li><h6 class="dropdown-header">Mapping Model</h6></li>
    <li n:foreach="$sourceVersionNames as $versionName">
        <button class="dropdown-item d-flex align-items-center gap-2" type="button" data-mapping-action="seedModelMap" data-version="{$versionName}" {$mappedVersionNames->containsElement($versionName) ? disabled}>
            <span class="material-symbols-outlined">{$mappedVersionNames->containsElement($versionName) ? "check" : "add_circle"}</span>
            <span class="text-truncate">New Map From {$versionName}</span>
        </button>
    </li>
    <li n:if="$sourceVersionNames->isEmpty">
        <span class="dropdown-item-text text-secondary small">No frozen versions yet</span>
    </li>
    <li>
        <hr class="dropdown-divider">
    </li>
    <li>
        <button class="dropdown-item d-flex align-items-center gap-2" type="button" data-mapping-action="removeSelection" data-item="{$selection|json}" {!$selection instanceof Sabatier\CoreData\ManagedObject ? disabled}>
            <span class="material-symbols-outlined">delete</span> <span>Remove</span>
        </button>
    </li>
    <li>
        <hr class="dropdown-divider">
    </li>
    <li>
        <button class="dropdown-item d-flex align-items-center gap-2" type="button" data-mapping-action="upgradeModel" data-item="{$selectedModelMap|json}" {!$selectedModelMap instanceof App\Model\ModelMap || $selectedModelMap->sourceModel === null || !$selectedModelMap->invalidEntityMaps->isEmpty ? disabled}>
            <span class="material-symbols-outlined">upgrade</span> <span>Upgrade Store...</span>
        </button>
    </li>
{/define}
