{varType Sabatier\Foundation\ArrayClass $rootEntities}
{varType Sabatier\Foundation\ArrayClass $fetchRequests}
{define model}
    <div class="d-block text-secondary text-uppercase fs-6 fw-bold ps-2 text-shadow">Entities</div>
    <div>{include entities from "Entities.latte", $rootEntities}</div>
    <div class="d-block text-secondary text-uppercase fs-6 fw-bold ps-2 text-shadow">Fetch Request</div>
    <div>{include fetchRequests from "FetchRequests.latte", $fetchRequests}</div>
    <div class="d-block text-secondary text-uppercase fs-6 fw-bold ps-2 text-shadow">Configurations</div>
    <div></div>
{/define}
