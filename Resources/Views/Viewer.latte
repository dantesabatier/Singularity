{layout "Layout.latte"}
{templateType App\ViewControllers\ViewerController}
{block title}{$title}{/block}
{block head}{/block}
{block content}
    <div id="main" data-view="viewer" class="user-select-none">
        <nav class="navbar sticky-top border-bottom user-select-none p-0" style="height: 40px; -webkit-app-region: drag; background-color: var(--bg-tertiary); border-color: var(--border-color) !important;">
            <div class="container-fluid justify-content-start align-items-center px-2">
                <div class="navbar-brand mb-0 me-2">
                    <img src="/Resources/Images/icon24@1x.png" srcset="/Resources/Images/icon24@2x.png 2x, /Resources/Images/icon24@3x.png 3x" alt="{$title}" class="d-inline-block">
                </div>
                <div class="dropdown">
                    <button class="btn btn-icon px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="-webkit-app-region: no-drag;" data-bs-placement="bottom" data-bs-title="Main Menu">
                        <span class="material-symbols-outlined">menu</span>
                    </button>
                    <ul class="dropdown-menu">
                        <li><h6 class="dropdown-header">View Options</h6></li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center gap-2" type="button" data-viewer-action="resetZoom">
                                <span class="material-symbols-outlined">fullscreen</span> <span>Reset Zoom</span>
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center gap-2" type="button" data-viewer-action="centerView">
                                <span class="material-symbols-outlined">my_location</span> <span>Center View</span>
                            </button>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li><h6 class="dropdown-header">Actions</h6></li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center gap-2" type="button" data-viewer-action="showExportModal">
                                <span class="material-symbols-outlined">download</span> <span>Export Schema</span>
                            </button>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" data-viewer-action="showAboutPanel">
                                <span class="material-symbols-outlined">info</span> <span>About</span>
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="dropdown ms-2">
                    <button type="button" class="btn btn-sm d-flex align-items-center gap-2 px-2" data-bs-toggle="dropdown" aria-expanded="false" style="-webkit-app-region: no-drag; background-color: var(--bg-hover); border: 1px solid var(--border-color);">
                        <span class="d-inline-flex align-items-center justify-content-center rounded text-center fw-semibold" style="width: 20px; height: 20px; background-color: {$project->color|noescape}; font-size: 11px;">
                            {$project->name|first}
                        </span> <span class="text-truncate" style="max-width: 200px;">{$project->name}</span>
                        <span class="material-symbols-outlined" style="font-size: 10px;">expand_more</span>
                    </button>
                    <ul class="dropdown-menu">
                        <li><h6 class="dropdown-header">Database Schema</h6></li>
                        <li>
                            <div class="dropdown-item d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined">database</span> <span>{$project->name}</span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="viewer-container" style="height: calc(100vh - 68px); position: relative;">
            <div id="viewer-runtime" data-project-id="{$project->objectID|json}" data-export-last-directory="{$exportLastDirectory}" style="display: none;"></div>
            <script id="viewer-schema-json" type="application/json">{$project->model?->schema|json|noescape}</script>
            <div class="viewer-toolbar">
                <div class="viewer-toolbar-section">
                    <button class="btn-icon" data-viewer-action="zoomIn" title="Zoom In">
                        <span class="material-symbols-outlined">zoom_in</span>
                    </button>
                    <button class="btn-icon" data-viewer-action="zoomOut" title="Zoom Out">
                        <span class="material-symbols-outlined">zoom_out</span>
                    </button>
                    <button class="btn-icon" data-viewer-action="resetZoom" title="Reset Zoom">
                        <span class="material-symbols-outlined">fullscreen</span>
                    </button>
                </div>
                <div class="viewer-toolbar-divider"></div>
                <div class="viewer-toolbar-section">
                    <button class="btn-icon" data-viewer-action="centerView" title="Center View">
                        <span class="material-symbols-outlined">my_location</span>
                    </button>
                </div>
                <div class="viewer-toolbar-divider"></div>
                <div class="viewer-toolbar-section">
                    <span class="viewer-toolbar-label">Zoom:</span>
                    <span id="viewer-zoom-level" class="viewer-toolbar-label">25%</span>
                </div>
            </div>
            <db-viewer></db-viewer>
            <div id="viewer-empty-state" class="viewer-empty-state" style="display: none;">
                <span class="material-symbols-outlined">database</span>
                <h3>No Schema Available</h3>
                <p>The database schema is empty or not loaded yet</p>
            </div>
        </div>
        <nav class="breadcrumb-nav" aria-label="breadcrumb">
            <ol class="breadcrumb-list">
                <li class="breadcrumb-item-wrapper">
                    <div class="breadcrumb-link">
                        <img class="breadcrumb-icon" src="/Resources/Images/icon16@1x.png" srcset="/Resources/Images/icon16@2x.png 2x, /Resources/Images/icon16@3x.png 3x" alt="">
                        <span>{$project->name}</span>
                    </div>
                </li>
                <li class="breadcrumb-item-wrapper">
                    <div class="breadcrumb-link">
                        <span class="material-symbols-outlined breadcrumb-icon" style="font-size: 14px;">database</span>
                        <span>Schema</span>
                    </div>
                </li>
            </ol>
        </nav>
    </div>
    <div class="modal fade ide-modal" id="exportModal" tabindex="-1" aria-labelledby="exportModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" id="exportModalLabel">Export Schema</h6>
                </div>
                <div class="modal-body">
                    <div class="modal-form-field">
                        <label for="exportLastDirectory" class="modal-form-label">
                            <span class="material-symbols-outlined">folder</span> Export Location </label>
                        <div class="input-group">
                            <input type="text" id="exportLastDirectory" class="form-control" placeholder="Choose a folder to export the schema" value="{$exportLastDirectory}" readonly>
                            <button type="button" class="btn btn-secondary" data-viewer-action="chooseExportFolder">
                                <span class="material-symbols-outlined">folder_open</span> <span>Browse...</span>
                            </button>
                        </div>
                        <small class="form-text" style="color: var(--text-disabled); font-size: 11px; margin-top: 4px; display: block;">Select the directory where the MariaDB SQL file will be saved</small>
                    </div>
                    <div class="modal-form-field">
                        <form action="/Synchronize" method="POST" class="needs-validation">
                            <label class="modal-form-label">Export Options</label>
                            <div class="config-option" style="margin-bottom: 8px;">
                                <input class="form-check-input" type="checkbox" name="exportIncludeData" id="exportIncludeData" value="{$exportIncludeData|json}" {$exportIncludeData ? 'checked' : ''}>
                                <label for="exportIncludeData" style="cursor: pointer;">
                                    <span class="d-block" style="font-size: 12px; color: var(--text-primary);">Include sample data</span>
                                </label>
                            </div>
                            <div class="config-option">
                                <input class="form-check-input" type="checkbox" name="exportIncludeComments" id="exportIncludeComments" value="{$exportIncludeComments|json}" {$exportIncludeComments ? 'checked' : ''}>
                                <label for="exportIncludeComments" style="cursor: pointer;">
                                    <span class="d-block" style="font-size: 12px; color: var(--text-primary);">Include comments</span>
                                </label>
                            </div>
                        </form>
                    </div>
                    <div class="modal-help-text">
                        <span class="material-symbols-outlined">info</span>
                        <div>
                            The schema will be exported as a MariaDB-compatible SQL file
                            <span class="help-note">Compatible with MySQL 5.7+ and MariaDB 10.2+</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="confirmExportBtn" data-viewer-action="confirmExport">
                        <span>Export</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
{/block}
