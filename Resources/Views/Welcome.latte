{layout "Layout.latte"}
{templateType App\ViewControllers\WelcomeController}
{block title}{$title}{/block}
{block head}{/block}
{block content}
    <div id="main" data-view="welcome" class="user-select-none">
        <nav class="welcome-navbar">
            <div class="container-fluid">
                <div class="navbar-brand">
                    <img src="/Resources/Images/icon16@1x.png" srcset="/Resources/Images/icon16@2x.png 2x, /Resources/Images/icon16@3x.png 3x" alt="{$title}">
                    <span>{$title}</span>
                </div>
            </div>
        </nav>
        <div class="welcome-container">
            <div id="welcome-view" class="transition-panel active">
                <div class="welcome-content">
                    <div class="welcome-actions">
                        <div class="welcome-intro">
                            <h2>{$title}</h2>
                            <p>Get started by creating a new project or opening an existing one.</p>
                        </div>
                        <div class="action-buttons">
                            <button class="action-btn" data-welcome-action="showNewProjectView">
                                <i class="bi bi-plus-circle"></i> <span>Create New Project</span>
                            </button>
                            <button class="action-btn" data-welcome-action="openProject">
                                <i class="bi bi-folder2-open"></i> <span>Open Existing Project</span>
                            </button>
                        </div>
                    </div>

                    <div class="recent-projects-panel">
                        <h6 class="panel-title">Recent Projects</h6>
                        {if $projects->isEmpty}
                            <div class="empty-state">
                                <i class="bi bi-inbox"></i>
                                <p>No recent projects</p>
                                <small>Projects you open will appear here</small>
                            </div>
                        {else}
                            <div class="list-group list-group-flush">
                                {foreach $projects as $project}
                                    {var $path = $project->url->path}
                                    <div class="list-group-item">
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="project-avatar color-picker cursor-pointer" style="background-color: {$project?->color|noescape};" data-jscolor="{ value: '{$project?->color|noescape}', preset: 'dark'}" data-project="{$project->objectID->referenceObject}">
                                                {$project->name|first|upper}
                                            </span>
                                            <div class="project-info cursor-pointer" data-welcome-action="openEditor" data-project-id="{$project->objectID->referenceObject}">
                                                <div class="project-name text-truncate">
                                                    {$project->name}
                                                </div>
                                                <div class="project-path text-truncate" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="{$path}">
                                                    {$path}
                                                </div>
                                            </div>
                                            <div class="dropdown project-actions-btn">
                                                <button class="btn btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li>
                                                        <button class="dropdown-item" data-welcome-action="openEditor" data-project-id="{$project->objectID->referenceObject}">
                                                            <i class="bi bi-folder2-open"></i> <span>Open Project</span>
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item" data-welcome-action="renameProject" data-project-id="{$project->objectID->referenceObject}" data-project-name="{$project->name}">
                                                            <i class="bi bi-folder"></i> <span>Rename Project...</span>
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item" data-welcome-action="openPath" data-project-path="{$path}">
                                                            <i class="bi bi-folder"></i> <span>Show in Explorer</span>
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <hr class="dropdown-divider">
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item text-danger" data-welcome-action="removeProject" data-project-id="{$project->objectID->referenceObject}" data-project-name="{$project->name}">
                                                            <i class="bi bi-trash"></i> <span>Remove from List</span>
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                {/foreach}
                            </div>
                        {/if}
                    </div>
                </div>
            </div>

            <div id="new-project-view" class="transition-panel">
                <div class="new-project-content">
                    <div class="new-project-header">
                        <h2>Create New Project</h2>
                        <p>Configure your new project settings</p>
                    </div>
                    <form action="/Create" method="POST" id="new-project-form" class="new-project-form">
                        <section class="form-section-group">
                            <h6 class="section-title">Project Location</h6>
                            <div class="form-group">
                                <label for="directory" class="form-label"> <i class="bi bi-folder"></i>
                                    <span>Project Folder</span> </label>
                                <div class="input-group">
                                    <input type="text" name="directory" id="directory" placeholder="Choose a folder for your new project" class="form-control" value="{$directory}" readonly>
                                    <button type="button" class="btn btn-secondary" data-welcome-action="chooseProjectFolder">
                                        <i class="bi bi-folder2-open"></i> <span>Browse...</span>
                                    </button>
                                </div>
                                <small class="form-text">Select the directory where your project files will be created</small>
                            </div>
                        </section>
                        <section class="form-section-group">
                            <h6 class="section-title">Configuration Options</h6>
                            <div class="config-options">
                                <div class="config-option">
                                    <input class="form-check-input" type="checkbox" name="generateWithSecurity" id="generateWithSecurity" value="{$generateWithSecurity|json}" {$generateWithSecurity ? checked}>
                                    <label for="generateWithSecurity">
                                        <span class="option-header d-block">
                                                <i class="bi bi-shield-check text-success"></i>
                                            <span>Advanced Security Policies</span>
                                        </span>
                                        <span class="d-block">Generates project code with stricter access control policies for enhanced security</span>
                                    </label>
                                </div>

                                <div class="config-option">
                                    <input class="form-check-input" type="checkbox" name="generateWithCORS" id="generateWithCORS" value="{$generateWithCORS|json}" {$generateWithCORS ? checked}>
                                    <label for="generateWithCORS">
                                        <span class="option-header d-block">
                                            <i class="bi bi-globe text-info"></i> <span>CORS Support</span>
                                        </span>
                                        <span class="d-block">Allow access from external web apps like React or Vue by adding default CORS configuration</span>
                                    </label>
                                </div>

                                <div class="config-option">
                                    <input class="form-check-input" type="checkbox" name="generateWithJWT" id="generateWithJWT" value="{$generateWithJWT|json}" {$generateWithJWT ? checked}>
                                    <label for="generateWithJWT">
                                        <span class="option-header d-block">
                                            <i class="bi bi-key text-warning"></i> <span>JWT Authentication</span>
                                        </span>
                                        <span class="d-block">Enable Bearer authentication with JWT tokens for secure API access</span>
                                    </label>
                                </div>
                            </div>
                        </section>
                    </form>
                </div>
            </div>
        </div>
        <div class="welcome-footer">
            <div class="container-fluid">
                <div id="settings-menu" class="dropup">
                    <button type="button" class="btn btn-icon" data-bs-toggle="dropdown" aria-expanded="false" title="Settings">
                        <i class="bi bi-gear"></i>
                    </button>
                    <ul class="dropdown-menu">
                        <li>
                            <button class="dropdown-item" type="button" data-welcome-action="showAboutPanel">
                                <i class="bi bi-info-circle"></i> <span>About</span>
                            </button>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <button class="dropdown-item" data-welcome-action="showPreferences">
                                <i class="bi bi-sliders"></i> <span>Preferences</span>
                            </button>
                        </li>
                    </ul>
                </div>
                <div id="project-actions">
                    <button type="button" class="btn btn-secondary" data-welcome-action="showWelcomeView">
                        <span>Cancel</span>
                    </button>
                    <button type="submit" id="create-project-btn" form="new-project-form" class="btn btn-primary" disabled>
                        <span>Create Project</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade ide-modal" id="editProject" tabindex="-1" aria-labelledby="editProjectLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" id="editProjectLabel">Rename Project</h6>
                </div>
                <form action="/Rename" method="POST">
                    <div class="modal-body">
                        <div class="modal-form-field">
                            <label for="name" class="modal-form-label">Project Name</label>
                            <input type="text" name="name" id="name" class="form-control" placeholder="Enter new project name" spellcheck="false" autocomplete="off" required>
                        </div>
                    </div>
                    <input type="hidden" name="X-Http-Method-Override" value="PATCH">
                    <input type="hidden" name="objectID">
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Rename</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{/block}
