{layout "Layout.latte"}
{varType string $title}
{varType string $version}
{varType string $shortVersion}
{varType string $copyright}
{varType Sabatier\Foundation\ArrayClass $projects}
{block title}{$title}{/block}
{block content}
    <div id="main" class="container-fluid min-vh-100 d-flex flex-column user-select-none">
        <div class="row flex-grow-1">
            <div class="col-sm-2 col-md-3 align-self-center">
            </div>
            <div class="col-sm-8 col-md-6 align-self-center">
                <div class="card" style="min-height: 400px">
                    <div class="card-header">
                        <button class="btn border-0 bg-transparent" type="button" data-bs-toggle="modal" data-bs-target="#showAboutPanel">
                            {$title}
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="container-fluid">
                            <div class="row">
                                <div class="col-7 border-end">
                                    <h2 class="text-truncate">Welcome to {$title}</h2>
                                    <button class="list-group-item list-group-item-action text-primary border-0 text-truncate" data-bs-toggle="modal" data-bs-target="#addProject">
                                        Create a new project
                                    </button>
                                </div>
                                <div class="col-5 overflow-auto" style="max-height: 300px">
                                    {if !$projects->isEmpty()}
                                        <ol class="list-group">
                                            <li n:foreach="$projects as $project" class="list-group-item display-block">
                                                <div class="row p-2">
                                                    <div class="col-10">
                                                        <span class="fw-bold">
                                                            <button class="dropdown-item" type="button" onclick="load({$project})">
                                                                <i class="bi bi-box"></i>
                                                                {$project->name}
                                                            </button>
                                                        </span>
                                                        <div class="text-truncate">{$project->url->path}</div>
                                                    </div>
                                                    <div class="col-2">
                                                        <button class="btn border-0 bg-transparent" data-bs-action-name="Project" onclick="remove(this, {$project})">
                                                            <i class="material-icons-outlined">
                                                                highlight_off
                                                            </i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </li>
                                        </ol>
                                    {else}
                                        No Recent Projects
                                    {/if}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button class="btn border-0 bg-transparent" onclick="showPreferences()">
                            <span class="material-icons-outlined">
                                settings
                            </span>
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-sm-2 col-md-3 align-self-center">
            </div>
        </div>
        <div class="modal fade" id="showAboutPanel" tabindex="-1" aria-labelledby="showAboutPanelLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                        </button>
                    </div>
                    <div class="modal-body text-center">
                        <h5>{$title}</h5>
                        <p>Version {$shortVersion} ({$version})</p>
                        <p>{$copyright}</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal fade" id="addProject" data-bs-backdrop="static" tabindex="-1" aria-labelledby="newProjectLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form action="/Create" id="addProject" method="POST">
                        <div class="modal-body">
                            <h5 class="modal-title mb-3" id="newProjectLabel">New Project</h5>
                            <label for="location" class="form-label">Location</label>
                            <input type="text" name="location" id="location" class="form-control" required>
                        </div>
                        <div class="modal-footer border-0">
                            <button type="button" class="btn btn-outline-secondary border-0 bg-transparent text-secondary" data-bs-dismiss="modal">
                                Cancel
                            </button>
                            <button type="submit" class="btn btn-outline-primary border-0 bg-transparent text-primary">
                                Create
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="modal fade" id="alert" data-bs-backdrop="static" tabindex="-1" aria-labelledby="removeItemLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form id="alert" method="POST">
                        <div class="modal-body">
                            <h5 class="modal-title mb-3" id="removeItemLabel"></h5>
                            <div class="modal-message"></div>
                        </div>
                        <div class="modal-footer border-0">
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{/block}
