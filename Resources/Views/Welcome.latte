{layout "Layout.latte"}
{templateType App\ViewControllers\Welcome}
{block title}{$title}{/block}
{block content}
    <div id="main" class="user-select-none">
        <nav class="navbar sticky-top bg-dark border-bottom border-black p-0" style="height: 40px; -webkit-app-region: drag">
            <div class="container-fluid justify-content-start">
                <div class="navbar-brand">
                    <img src="/Resources/Images/icon16@1x.png" srcset="/Resources/Images/icon16@2x.png 2x, /Resources/Images/icon16@3x.png 3x" alt="{$title}" class="d-inline-block">
                    <span class="fs-6">{$title}</span>
                </div>
            </div>
        </nav>
        <div class="container-fluid d-flex flex-column">
            <div class="row">
                <div class="col-sm-7 overflow-auto" style="height: calc(100vh - 40px)">
                    <div class="p-2">
                        <h2 class="text-wrap-word">Welcome to {$title}</h2>
                        <button class="text-primary text-truncate border-0 bg-transparent" onclick="create(register)">
                            Create a new project
                        </button>
                    </div>
                </div>
                <div class="col-sm-5 overflow-auto bg-dark-subtle" style="height: calc(100vh - 40px)">
                    <div n:if="$projects->isEmpty">No Recent Projects</div>
                    <ol n:else class="list-group bg-dark-subtle py-2 h-100">
                        <li n:foreach="$projects as $project" class="list-group-item list-group-item-action display-block border-0 rounded p-2">
                            {var $path = $project->url->path}
                            <div class="row align-items-center">
                                <div class="col-sm-10">
                                    <div class="d-flex">
                                        <span class="d-inline-block rounded text-center fw-medium cursor-pointer color-picker" style="width: 24px; height: 24px;" data-jscolor="{
                                        value: '{$project?->color|noescape}',
                                        preset: 'dark',
                                        }" data-project="{$project->objectID->referenceObject}">{$project->name|first}</span>
                                        <span class="d-inline-block fw-bold ps-2 w-100 cursor-pointer" onclick="show({$project})">{$project->name}</span>
                                    </div>
                                    <small class="d-block text-truncate text-muted" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="{$path}">{$path}</small>
                                </div>
                                <div class="col-sm-2 text-end">
                                    <div class="dropdown">
                                        <button class="btn icon p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <button class="dropdown-item" onclick="show({$project})">
                                                    Open Selected
                                                </button>
                                            </li>
                                            <li>
                                                <button class="dropdown-item" onclick="explorer({$path})">
                                                    Show in Explorer
                                                </button>
                                            </li>
                                            <li>
                                                <hr class="dropdown-divider">
                                            </li>
                                            <li>
                                                <button class="dropdown-item" onclick="rename({$project})">
                                                    Rename Project...
                                                </button>
                                            </li>
                                            <li>
                                                <hr class="dropdown-divider">
                                            </li>
                                            <li>
                                                <button class="dropdown-item" onclick="remove({$project}, register)">
                                                    Remove Project
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </li>
                    </ol>
                </div>
            </div>
            <div class="navbar fixed-bottom align-content-center" style="height: 56px;">
                <div class="container-fluid">
                    <div class="dropup">
                        <button type="button" class="btn icon dropdown p-2" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-gear" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Options Menu"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <button class="dropdown-item" type="button" onclick="showAboutPanel()">
                                    About
                                </button>
                            </li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li>
                                <button class="btn icon" onclick="showPreferences()">
                                    Preferences...
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal fade" id="editProject" tabindex="-1" aria-labelledby="editProjectLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form action="/Rename" method="POST">
                        <div class="modal-body">
                            <div class="mb-3">
                                <h5 class="modal-title" id="editProjectLabel">Rename project</h5>
                            </div>
                            <div class="mb-3">
                                <label for="name" class="form-label form-control-sm">Enter new project name</label>
                                <input type="text" name="name" id="name" class="form-control form-control-sm" spellcheck="false" autocomplete="off" required>
                            </div>
                        </div>
                        <div class="modal-footer border-0">
                            <input type="hidden" name="X-Http-Method-Override" value="PATCH">
                            <input type="hidden" name="objectID">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                Cancel
                            </button>
                            <button type="submit" class="btn btn-primary">
                                OK
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <script>
        /**
         * @param { object } project
         */
        const rename = (project) => {
            const element = document.getElementById("editProject")
            /**
             * @type { HTMLFormElement }
             */
            const form = element.querySelector(".modal-content form")
            /**
             * @type { HTMLInputElement }
             */
            const nameElement = form.querySelector("input[type=text]")
            nameElement.value = project.name
            const footer = form.querySelector(".modal-footer")
            /**
             * @type { HTMLInputElement }
             */
            const projectElement = footer.querySelector("input[name=objectID]")
            projectElement.value = project.objectID
            const modal = new bootstrap.Modal(element, {})
            modal.show(undefined)
            element.addEventListener("shown.bs.modal", () => nameElement.focus())
        }
    </script>
{/block}
