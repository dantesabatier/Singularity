{layout "Layout.latte"}
{templateType App\Contexts\Welcome}
{block title}{$title}{/block}
{block content}
    <div id="main" class="container-fluid min-vh-100 d-flex flex-column user-select-none">
        <div class="row flex-grow-1 justify-content-center">
            <div class="ratio ratio-16x9 w-50 h-25 align-self-center">
                <div class="card" style="min-height: 380px">
                    <div class="card-header">
                        <button class="btn border-0 bg-transparent" type="button" onclick="showAboutPanel({$info})">
                            {$title}
                        </button>
                        <div class="spinner-border spinner-border-sm text-primary float-end" role="status" hidden>
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="container-fluid">
                            <div class="row">
                                <div class="col-sm-6 border-end">
                                    <h2 class="text-wrap-word">Welcome to {$title}</h2>
                                    <button class="list-group-item list-group-item-action text-primary border-0 text-truncate" onclick="create()">
                                        Create a new project
                                    </button>
                                </div>
                                <div class="col-sm-6">
                                    <div class="overflow-auto border rounded" style="height: 236px">
                                        {if !$projects->isEmpty}
                                            <ol class="list-group">
                                                <li n:foreach="$projects as $project" class="list-group-item display-block rounded-0 border-0 border-bottom">
                                                    <div class="row">
                                                        <div class="col-sm-9 cursor-pointer" onclick="load({$project})">
                                                            <div class="d-flex">
                                                                <span class="material-symbols-outlined d-inline">deployed_code</span>
                                                                <span class="fw-bold d-inline">{$project->name}</span>
                                                            </div>
                                                            <div class="d-block text-truncate">{$project->url->path}</div>
                                                        </div>
                                                        <div class="col-sm-3">
                                                            <div class="d-flex align-items-end">
                                                                <button class="btn border-0 bg-transparent d-inline" onclick="remove({$project})">
                                                                    <span class="material-symbols-outlined">cancel</span>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </li>
                                            </ol>
                                        {else}
                                            No Recent Projects
                                        {/if}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button class="btn border-0 bg-transparent" onclick="showPreferences()">
                            <span class="material-symbols-outlined">
                                settings
                            </span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{/block}
