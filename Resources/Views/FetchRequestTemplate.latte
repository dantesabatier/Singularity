{varType App\Model\FetchRequestTemplate $selectedFetchRequestTemplate}
{varType Sabatier\Foundation\ArrayClass $allEntities}
{define fetchRequestTemplate}
    <form action="/FetchRequestTemplate" method="POST">
        <div class="my-2 fs-6 fw-bold text-shadow">
            Fetch Request
        </div>
        <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <input type="text" name="name" id="name" placeholder="Fetch Index Name" class="form-control text-truncate" value="{$selectedFetchRequestTemplate->name}" autocomplete="off" spellcheck="false" required>
        </div>
        <hr>
        <div class="mt-3 mb-3">
            <label for="fetchRequestEntityName" class="form-label">Entity</label>
            <select name="fetchRequestEntityName" id="fetchRequestEntityName" class="form-select" data-autosave="true">
                <option value="">No entity</option>
                <option n:foreach="$allEntities as $entity" value="{$entity->name}" {$entity->name === $selectedFetchRequestTemplate->fetchRequestEntityName ? selected}>{$entity->name}</option>
            </select>
        </div>
        <input type="hidden" name="objectID" value="{$selectedFetchRequestTemplate->objectID->referenceObject}">
        <input type="hidden" name="X-Http-Method-Override" value="PATCH">
        <input class="d-none" type="submit">
    </form>
{/define}