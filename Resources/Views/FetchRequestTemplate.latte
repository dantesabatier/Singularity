{templateType App\ViewControllers\EditorController}
{define fetchRequestTemplate}
    <div class="px-3 pb-4">
        <form action="/FetchRequestTemplate" method="POST">
            <input type="hidden" name="objectID" value="{$selectedFetchRequestTemplate->objectID->referenceObject}">

            <div class="inspector-header">Fetch Request</div>

            <div class="row mb-2">
                <label for="name" class="col-sm-4 inspector-label">Name</label>
                <div class="col-sm-8">
                    <input type="text" name="name" id="name" placeholder="Fetch Request Name" class="form-control form-control-sm text-truncate fw-bold" value="{$selectedFetchRequestTemplate->name}" autocomplete="off" spellcheck="false" required>
                </div>
            </div>

            <div class="row mb-2">
                <label for="fetchEntityName" class="col-sm-4 inspector-label">Entity</label>
                <div class="col-sm-8">
                    <select name="fetchEntityName" id="fetchEntityName" class="form-select form-select-sm" data-autosave="true">
                        <option n:foreach="$project->model->entities as $entity" value="{$entity->name}" {$entity->name === $selectedFetchRequestTemplate->fetchEntityName ? selected}>
                            {$entity->name}
                        </option>
                    </select>
                </div>
            </div>

            <div class="row mb-2">
                <label for="fetchResultType" class="col-sm-4 inspector-label">Result Type</label>
                <div class="col-sm-8">
                    <select name="fetchResultType" id="fetchResultType" class="form-select form-select-sm" data-autosave="true">
                        <option n:foreach="$fetchRequestResultTypes as $fetchRequestResultType" value="{$fetchRequestResultType->value}" {$fetchRequestResultType->value === $selectedFetchRequestTemplate?->fetchResultType ? selected}>
                            {$fetchRequestResultType->name}
                        </option>
                    </select>
                </div>
            </div>

            <div class="inspector-header">Execution</div>

            <div class="row mb-2">
                <label for="fetchLimit" class="col-sm-4 inspector-label">Fetch Limit</label>
                <div class="col-sm-8">
                    <input type="number" name="fetchLimit" id="fetchLimit" placeholder="0 (Unlimited)" class="form-control form-control-sm" value="{$selectedFetchRequestTemplate->fetchLimit}" autocomplete="off" spellcheck="false" required>
                </div>
            </div>

            <div class="row mb-2">
                <label for="fetchBatchSize" class="col-sm-4 inspector-label">Batch Size</label>
                <div class="col-sm-8">
                    <input type="number" name="fetchBatchSize" id="fetchBatchSize" placeholder="0" class="form-control form-control-sm" value="{$selectedFetchRequestTemplate->fetchBatchSize}" autocomplete="off" spellcheck="false" required>
                </div>
            </div>

            <div class="inspector-header">Options</div>

            <div class="row mb-2">
                <div class="col-sm-4"></div>
                <div class="col-sm-8">
                    <div class="d-flex flex-column gap-1">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="includesSubentities" value="{$selectedFetchRequestTemplate->includesSubentities|json}" id="includesSubentities" {$selectedFetchRequestTemplate->includesSubentities ? checked}>
                            <label class="form-check-label small text-secondary" for="includesSubentities">Include Subentities</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="includesPropertyValues" value="{$selectedFetchRequestTemplate->includesPropertyValues|json}" id="includesPropertyValues" {$selectedFetchRequestTemplate->includesPropertyValues ? checked}>
                            <label class="form-check-label small text-secondary" for="includesPropertyValues">Include Property Values</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="returnsObjectsAsFaults" value="{$selectedFetchRequestTemplate->returnsObjectsAsFaults|json}" id="returnsObjectsAsFaults" {$selectedFetchRequestTemplate->returnsObjectsAsFaults ? checked}>
                            <label class="form-check-label small text-secondary" for="returnsObjectsAsFaults">Return Objects as Faults</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="includesPendingChanges" value="{$selectedFetchRequestTemplate->includesPendingChanges|json}" id="includesPendingChanges" {$selectedFetchRequestTemplate->includesPendingChanges ? checked}>
                            <label class="form-check-label small text-secondary" for="includesPendingChanges">Include Pending Changes</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="returnsDistinctResults" value="{$selectedFetchRequestTemplate->returnsDistinctResults|json}" id="returnsDistinctResults" {$selectedFetchRequestTemplate->returnsDistinctResults ? checked}>
                            <label class="form-check-label small text-secondary" for="returnsDistinctResults">Return Distinct Results</label>
                        </div>
                    </div>
                </div>
            </div>

            <input type="hidden" name="X-Http-Method-Override" value="PATCH">
            <input class="d-none" type="submit">
        </form>
    </div>
{/define}
