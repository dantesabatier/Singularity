<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#272b2f">
    <meta name="color-scheme" content="light dark">
    <title>{block title}{/block}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
    <link rel="stylesheet" type="text/css" href="/Resources/Styles/Layout.css" media="screen">
    <link rel="stylesheet" type="text/css" href="/Resources/Styles/PredicateHighlighter.css" media="screen">
    {block head}{/block}
</head>
<body>
{block content}{/block}
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" crossorigin="anonymous" defer></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/split.js/1.6.5/split.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/db-viewer-component@4.4.9/dist/main.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jscolor/2.5.2/jscolor.min.js" integrity="sha512-qFhMEJrjI50TwLDGZ7Oi0ksTSWnFOqTNXhlqqUgWnE65S23rWUtQOv+tMNEybkMYSXKgAc3eg/SzkX+qrtJT/g==" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
<script src="https://cdn.jsdelivr.net/npm/cytoscape@3.33.1/dist/cytoscape.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/dagre@0.8.5/dist/dagre.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/cytoscape-dagre@2.5.0/cytoscape-dagre.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/cytoscape-node-html-label@1.2.2/dist/cytoscape-node-html-label.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js" defer></script>
<script src="/Resources/Scripts/PredicateHighlighter.js" defer></script>
<script type="text/javascript" src="../../electron/renderer.js" defer></script>
<!--suppress JSCheckFunctionSignatures, JSUnresolvedReference -->
<script>
    window.activePopover = null
    const register = () => {
        jscolor.install()
        document.querySelectorAll(".tree-toggle").forEach(e => {
            e.addEventListener("click", event => {
                event.stopPropagation()
                send("Entity", {
                    objectID: e.dataset.id,
                    isExpanded: e.dataset.expanded,
                }, "PATCH")
            }, {
                once: true
            })
        })
        document.querySelectorAll("[data-href]").forEach(e => {
            e.addEventListener("click", () => {
                push(window.location.origin + e.dataset.href)
            }, {
                once: true
            })
        })
        document.querySelectorAll("select[data-autosave=true]").forEach(e => {
            e.addEventListener("click", event => event.stopPropagation(), {
                once: true
            })
            e.addEventListener("change", event => {
                event.stopPropagation()
                submit(e.form)
            }, {
                once: true
            })
        })
        document.querySelectorAll("input[type=checkbox]").forEach(e => {
            e.addEventListener("click", event => {
                event.stopPropagation()
                submit(e.form)
            }, {
                once: true
            })
        })
        document.querySelectorAll("textarea").forEach(e => {
            e.addEventListener("change", event => {
                event.stopPropagation()
                submit(e.form)
            }, {
                once: true
            })
        })
        document.querySelectorAll("form:not(.needs-validation):not(.form-new-project)").forEach(e => {
            e.addEventListener("submit", event => {
                event.preventDefault()
                submit(e)
            }, {
                once: true
            })
        })
        document.querySelectorAll(".needs-validation").forEach(e => {
            e.addEventListener("submit", event => {
                event.preventDefault()
                if (!e.checkValidity()) {
                    event.stopPropagation()
                    e.classList.add("was-validated")
                    return
                }
                if (!e.classList.contains("form-new-project")) {
                    submit(e)
                }
            }, {
                once: false
            })
        })
        document.querySelectorAll(".modal").forEach(e => {
            e.addEventListener("hidden.bs.modal", () => {
                const form = e.querySelector(".modal-content form")
                if (form) {
                    form.reset()
                }
            }, {
                once: false
            })
        })
        document.querySelectorAll(`[data-bs-toggle="tooltip"]`).forEach(e => {
            const tooltip = new bootstrap.Tooltip(e, {
                container: "body",
                trigger: "hover"
            })
            e.addEventListener("click", () => tooltip.hide())
        })
        initPopovers()
        initializeRolePopovers()
        document.querySelectorAll("table[data-project][data-entity][data-key]").forEach(e => {
            const body = e.querySelector("tbody")
            if (!body) {
                return
            }
            Sortable.create(body, {
                onUpdate: event => {
                    if (event.oldIndex === event.newIndex) {
                        return
                    }
                    send("Reorder", {
                        project: e.dataset.project,
                        entity: e.dataset.entity,
                        key: e.dataset.key,
                        fromIndex: event.oldIndex,
                        toIndex: event.newIndex,
                    })
                }
            })
        })
        document.querySelectorAll(".color-picker").forEach(e => {
            const picker = e.jscolor
            if (!picker) {
                return
            }
            picker.hideOnPaletteClick = true
            picker.onChange = () => {
                send("Project", {
                    objectID: e.dataset.project,
                    color: picker.toHEXString()
                }, "PATCH")
            }
        })
    }
    const initPopovers = () => {
        document.querySelectorAll("[data-popover]").forEach(trigger => {
            const popId = trigger.dataset.popover
            const pop = document.getElementById(popId)
            if (!pop) {
                return
            }
            trigger.addEventListener("click", e => {
                e.stopPropagation()
                const isOpen = pop.classList.contains("open")
                document.querySelectorAll(".ide-popover.open").forEach(p => {
                    p.classList.remove("open")
                    p.setAttribute("aria-hidden", "true")
                    const btn = document.querySelector(`[data-popover="${ p.id }"]`)
                    btn?.setAttribute("aria-expanded", "false")
                })

                if (!isOpen) {
                    const rect = trigger.getBoundingClientRect()
                    const popW = 300
                    let left = rect.right - popW
                    let top = rect.bottom + 6
                    if (left < 8) {
                        left = 8
                    }
                    if (top + 400 > window.innerHeight) {
                        top = rect.top - 400 - 6
                    }
                    pop.style.left = left + "px"
                    pop.style.top = top + "px"
                    pop.classList.add("open")
                    pop.setAttribute("aria-hidden", "false")
                    trigger.setAttribute("aria-expanded", "true")
                }
            })
        })
        document.querySelectorAll("[data-popover-close]").forEach(btn => {
            btn.addEventListener("click", e => {
                e.stopPropagation()
                const pop = document.getElementById(btn.dataset.popoverClose)
                pop?.classList.remove("open")
                pop?.setAttribute("aria-hidden", "true")
            })
        })
        document.addEventListener("click", () => {
            document.querySelectorAll(".ide-popover.open").forEach(p => {
                p.classList.remove("open")
                p.setAttribute("aria-hidden", "true")
            })
            document.querySelectorAll("[data-popover]").forEach(t =>
                t.setAttribute("aria-expanded", "false")
            )
        })
        document.addEventListener("keydown", e => {
            if (e.key === "Escape") {
                document.querySelectorAll(".ide-popover.open").forEach(p => p.classList.remove("open"))
            }
        })
        document.querySelectorAll(".sp-chip").forEach(chip => {
            chip.addEventListener("click", e => {
                e.stopPropagation()
                navigator.clipboard?.writeText(chip.dataset.copy ?? chip.textContent.trim())
                chip.classList.add("copied")
                setTimeout(() => chip.classList.remove("copied"), 900)
            })
        })
        document.querySelectorAll(".sp-example").forEach(ex => {
            ex.addEventListener("click", e => {
                e.stopPropagation()
                navigator.clipboard?.writeText(ex.dataset.copy)
                ex.classList.add("copied")
                setTimeout(() => ex.classList.remove("copied"), 900)
            })
        })
    }
    const initializeRolePopovers = () => {
        document.querySelectorAll(`[data-bs-toggle="popover"]`).forEach(e => {
            const popover = new bootstrap.Popover(e, {
                container: "body",
                html: true,
                sanitize: false,
                trigger: "manual",
                content: "Loading…",
                customClass: "role-popover",
                placement: "auto",
                fallbackPlacements: ["top", "bottom", "left", "right"]
            })
            e.addEventListener("click", async (event) => {
                event.preventDefault()
                event.stopPropagation()
                event.stopImmediatePropagation()
                if (window.activePopover) {
                    window.activePopover.hide()
                    window.activePopover = null
                }
                try {
                    const url = new URL(window.location.href)
                    if (!url.searchParams.has("accessControl")) {
                        showError(popover, "Please select an access control first")
                        return
                    }
                    e.classList.add("loading")
                    url.searchParams.set("role", e.dataset.role)
                    const response = await request(url, undefined, "GET")
                    if (!response.ok) {
                        await showErrorBox((await response.json())?.error)
                        return
                    }
                    const html = await response.text()
                    const doc = new DOMParser().parseFromString(html, "text/html")
                    const template = doc.getElementById("roles-popover-content")
                    popover.setContent({".popover-body": template.innerHTML})
                    popover.show()
                    window.activePopover = popover
                } catch (error) {
                    console.error("Failed to load role popover:", error)
                    showError(popover, "Failed to load role editor")
                } finally {
                    e.classList.remove("loading")
                }
            })
        })
        document.addEventListener("click", (event) => {
            if (window.activePopover &&
                !event.target.closest(".popover") &&
                !event.target.closest("[data-bs-toggle=\"popover\"]")) {
                window.activePopover.hide()
                window.activePopover = null
            }
        })
        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && window.activePopover) {
                window.activePopover.hide()
                window.activePopover = null
            }
        })
        document.addEventListener("shown.bs.popover", () => {
            const popoverBody = document.querySelector(".popover-body")
            if (!popoverBody) {
                return
            }
            /**
             * @type { HTMLFormElement }
             */
            const form = popoverBody.querySelector(".role-popover-form")
            /**
             * @type { HTMLSelectElement }
             */
            const select = form.querySelector(".role-select")
            /**
             * @type { HTMLDivElement }
             */
            const customField = form.querySelector(".role-custom-field")
            /**
             * @type { HTMLInputElement }
             */
            const customInput = form.querySelector("#scopeName")
            /**
             * @type { HTMLButtonElement }
             */
            const cancelBtn = form.querySelector(".role-cancel-btn")
            /**
             * @type { HTMLButtonElement }
             */
            const saveBtn = form.querySelector(".role-save-btn")
            select.addEventListener("change", () => {
                if (select.value === "Custom...") {
                    customField.style.display = "block"
                    customInput?.focus()
                } else {
                    customField.style.display = "none"
                }
            })
            cancelBtn.addEventListener("click", () => {
                if (window.activePopover) {
                    window.activePopover.hide()
                    window.activePopover = null
                }
            })
            saveBtn.addEventListener("click", (e) => {
                e.preventDefault()
                const selectedScope = select?.value
                const finalName = selectedScope === "Custom..." ? customInput?.value : selectedScope
                if (!finalName || finalName === "Custom...") {
                    customInput?.focus()
                    return
                }
                submit(form)
                if (window.activePopover) {
                    window.activePopover.hide()
                    window.activePopover = null
                }
            })
            customInput.addEventListener("keypress", (e) => {
                if (e.key === "Enter") {
                    e.preventDefault()
                    saveBtn?.click()
                }
            })
            if (!select.disabled) {
                select.focus()
            } else {
                customInput.focus()
            }
        })
    }
    const showError = (popover, message) => {
        popover.setContent({
            ".popover-body": `<div class="p-3 text-danger">
            <i class="bi bi-exclamation-triangle"></i>
            <span class="px-2">${
                message
            }</span>
        </div>`
        })
        popover.show()
        window.activePopover = popover
        setTimeout(() => {
            if (window.activePopover === popover) {
                window.activePopover.hide()
                window.activePopover = null
            }
        }, 2000)
    }
    const init = () => {
        window.addEventListener("popstate", event => replace(event.state?.url ?? window.location.origin))
        register()
    }
    document.addEventListener("DOMContentLoaded", init, {
        once: true
    })
    document.addEventListener("view:updated", init, {
        once: false
    })
</script>
{block scripts}{/block}
</body>
</html>
