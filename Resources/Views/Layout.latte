<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="color-scheme" content="#272b2f">
    <meta name="color-scheme" content="light dark">
    <title>{block title}{/block}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet"/>
    <link rel="apple-touch-icon" sizes="180x180" href="/Resources/Images/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/Resources/Images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/Resources/Images/favicon-16x16.png">
    <link rel="manifest" href="/Resources/site.webmanifest">
    <link rel="mask-icon" href="/Resources/Images/safari-pinned-tab.svg" color="#5bbad5">
    <link rel="stylesheet" type="text/css" href="/Resources/Layout.css" media="screen">
</head>
<body onload="init()">
{block content}{/block}
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous" defer></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous" defer></script>
<script type="text/javascript" src="../../app/renderer.js" defer></script>
<!--suppress JSCheckFunctionSignatures -->
<script>
    function layout() {
        document.querySelectorAll(`[class*="scroll-view"]`).forEach(e => e.style.height = document.documentElement.clientHeight - (40 + 28) + "px")
    }

    function register() {
        layout()
        document.querySelectorAll("select[data-autosave=true]").forEach(e => {
            e.addEventListener("click", async event => {
                event.stopPropagation()
            }, {
                once: true
            })
            e.addEventListener("change", async event => {
                event.stopPropagation()
                await submit(e.form)
            }, {
                once: true
            })
        })
        document.querySelectorAll(".btn-toggle").forEach(e => {
            e.addEventListener("click", async event => {
                event.stopPropagation()
            }, {
                once: true
            })
        })
        document.querySelectorAll("div[data-href]").forEach(e => {
            const location = window.location.origin + e.dataset.href
            e.addEventListener("click", async () => {
                if (window.location.href !== location) {
                    await push(location)
                }
            }, {
                once: true
            })
            e.addEventListener("contextmenu", async event => {
                event.preventDefault()
                showSourceListContextMenu({
                    objectID: Number(new URL(location).searchParams.get("entity")),
                    entityName: "Entity",
                    name: e.querySelector("span:not(.space)")?.innerText
                })
            }, {
                once: false
            })
        })
        document.querySelectorAll("tr[data-href]").forEach(e => e.addEventListener("click", async () => {
            const location = window.location.origin + e.dataset.href
            if (window.location.href !== location) {
                await push(location)
            }
        }, {
            once: true
        }))
        document.querySelectorAll("input[type=checkbox]").forEach(e => {
            e.addEventListener("click", async event => {
                event.stopPropagation()
                await submit(e.form)
            }, {
                once: true
            })
        })
        document.querySelectorAll("form:not(.needs-validation)").forEach(e => e.addEventListener("submit", async event => {
            event.preventDefault()
            await submit(e)
        }, {
            once: true
        }))
        document.querySelectorAll(".modal").forEach(e => e.addEventListener("hidden.bs.modal", () => {
            /**
             * @type { HTMLFormElement } form
             */
            const form = e.querySelector(".modal-content form")
            form.reset()
        }, {
            once: false
        }))
        document.querySelectorAll(".needs-validation").forEach(e => e.addEventListener("submit", async event => {
            if (e.checkValidity()) {
                event.preventDefault()
                await submit(e)
                return
            }
            event.preventDefault()
            event.stopPropagation()
            e.classList.add("was-validated")
        }, {
            once: false
        }))
        document.querySelectorAll(`[data-bs-toggle="tooltip"]`).forEach(e => new bootstrap.Tooltip(e), {
            once: true
        })
    }

    function init() {
        window.addEventListener("resize", layout)
        window.addEventListener("popstate", async event => await replace(event.state?.url ?? window.location.origin))
        register()
    }
</script>
</body>
</html>
