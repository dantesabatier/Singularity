<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#272b2f">
    <meta name="color-scheme" content="light dark">
    <title>{block title}{/block}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="apple-touch-icon" sizes="180x180" href="/Resources/Images/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/Resources/Images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/Resources/Images/favicon-16x16.png">
    <link rel="manifest" href="/Resources/site.webmanifest">
    <link rel="mask-icon" href="/Resources/Images/safari-pinned-tab.svg" color="#5bbad5">
    <link rel="stylesheet" type="text/css" href="/Resources/Styles/Layout.css" media="screen">
    {block head}{/block}
</head>
<body>
{block content}{/block}
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" crossorigin="anonymous" defer></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous" defer></script>
<script src="https://cdn.jsdelivr.net/npm/db-viewer-component@4.4.9/dist/main.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jscolor/2.5.2/jscolor.min.js" integrity="sha512-qFhMEJrjI50TwLDGZ7Oi0ksTSWnFOqTNXhlqqUgWnE65S23rWUtQOv+tMNEybkMYSXKgAc3eg/SzkX+qrtJT/g==" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
<script type="text/javascript" src="../../electron/renderer.js" defer></script>
<!--suppress JSCheckFunctionSignatures, JSUnresolvedReference -->
<script>
    const register = () => {
        jscolor.install()
        document.querySelectorAll(".tree-toggle").forEach(e => e.addEventListener("click", event => {
            event.stopPropagation()
            send("Entity", {
                objectID: e.dataset.id,
                isExpanded: e.dataset.expanded,
            }, "PATCH", register)
        }, {
            once: true
        }))
        document.querySelectorAll("div[data-href]").forEach(e => e.addEventListener("click", () => push(window.location.origin + e.dataset.href, register), {
            once: true
        }))
        document.querySelectorAll("tr[data-href]").forEach(e => e.addEventListener("click", () => push(window.location.origin + e.dataset.href, register), {
            once: true
        }))
        document.querySelectorAll("select[data-autosave=true]").forEach(e => {
            e.addEventListener("click", event => {
                event.stopPropagation()
            }, {
                once: true
            })
            e.addEventListener("change", event => {
                event.stopPropagation()
                submit(e.form, register)
            }, {
                once: true
            })
        })
        document.querySelectorAll("input[type=checkbox]").forEach(e => e.addEventListener("click", event => {
            event.stopPropagation()
            submit(e.form, register)
        }, {
            once: true
        }))
        document.querySelectorAll("textarea").forEach(e => e.addEventListener("change", event => {
            event.stopPropagation()
            submit(e.form, register)
        }, {
            once: true
        }))
        document.querySelectorAll(".form-new-project").forEach(e => e.addEventListener("submit", event => {
            event.preventDefault()
            create(e)
        }, {
            once: true
        }))
        document.querySelectorAll(".needs-validation").forEach(e => e.addEventListener("submit", event => {
            if (e.checkValidity()) {
                event.preventDefault()
                if (e.classList.contains("form-new-project")) {
                    return
                }
                submit(e, register)
                return
            }
            event.preventDefault()
            event.stopPropagation()
            e.classList.add("was-validated")
        }, {
            once: false
        }))
        document.querySelectorAll("form:not(.needs-validation)").forEach(e => e.addEventListener("submit", event => {
            event.preventDefault()
            if (e.classList.contains("form-new-project")) {
                return
            }
            submit(e, register)
        }, {
            once: true
        }))
        document.querySelectorAll(".modal").forEach(e => e.addEventListener("hidden.bs.modal", () => {
            /**
             * @type { HTMLFormElement } form
             */
            const form = e.querySelector(".modal-content form")
            form.reset()
        }, {
            once: false
        }))
        document.querySelectorAll(`[data-bs-toggle="tooltip"]`).forEach(e => {
            const tooltip = new bootstrap.Tooltip(e, {
                container: "body",
                trigger: "hover"
            })
            e.addEventListener("click", () => tooltip.hide())
        })
        let activePopover = null;
        document.querySelectorAll(`[data-bs-toggle="popover"]`).forEach(e => {
            const popover = new bootstrap.Popover(e, {
                container: "body",
                html: true,
                sanitize: false,
                trigger: "manual",
                content: "Loading…",
                customClass: "role-popover",
                placement: "auto",
                fallbackPlacements: ["top", "bottom", "left", "right"]
            })
            e.addEventListener("click", async event => {
                event.preventDefault()
                event.stopPropagation()
                event.stopImmediatePropagation()
                if (activePopover) {
                    activePopover.hide()
                }
                const url = new URL(window.location.href)
                if (!url.searchParams.get("accessControl")) {
                    popover.setContent({
                        ".popover-body": `<div class="p-3 text-danger"><i class="bi bi-exclamation-triangle"></i><span class="px-2">Failed to load the role, select an access control and try again.</span></div>`
                    })
                    popover.show()
                    activePopover = popover
                    setTimeout(() => {
                        if (activePopover === popover) {
                            activePopover.hide()
                            activePopover = null
                        }
                    }, 2000)
                    return
                }
                e.classList.add("loading")
                url.searchParams.set("role", e.dataset.role)
                const response = await fetch(url, {
                    method: "GET",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                })
                const html = await response.text()
                const parser = new DOMParser()
                const doc = parser.parseFromString(html, "text/html")
                const template = doc.getElementById("roles-popover-content")
                popover.setContent({
                    ".popover-body": template.innerHTML
                })
                popover.show()
                activePopover = popover
                e.classList.remove("loading")
            })
        })
        document.addEventListener("click", (event) => {
            if (activePopover && !event.target.closest(".popover") && !event.target.closest('[data-bs-toggle="popover"]')) {
                activePopover.hide()
                activePopover = null
            }
        })
        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && activePopover) {
                activePopover.hide();
                activePopover = null;
            }
        })
        document.addEventListener("shown.bs.popover", () => {
            const popoverBody = document.querySelector(".popover-body")
            if (!popoverBody) {
                return
            }
            /**
             * @type { HTMLFormElement }
             */
            const form = popoverBody.querySelector(".role-popover-form")
            /**
             * @type { HTMLSelectElement }
             */
            const select = form.querySelector(".role-select")
            /**
             * @type { HTMLDivElement }
             */
            const customField = form.querySelector(".role-custom-field")
            /**
             * @type { HTMLInputElement }
             */
            const customInput = form.querySelector("#scopeName")
            /**
             * @type { HTMLButtonElement }
             */
            const cancelBtn = form.querySelector(".role-cancel-btn")
            /**
             * @type { HTMLButtonElement }
             */
            const saveBtn = form.querySelector(".role-save-btn")
            select.addEventListener("change", () => {
                if (select.value === "custom...") {
                    customField.style.display = "block"
                    customInput?.focus()
                } else {
                    customField.style.display = "none"
                }
            })
            cancelBtn.addEventListener("click", () => {
                if (activePopover) {
                    activePopover.hide()
                    activePopover = null
                }
            })
            saveBtn.addEventListener("click", function (e) {
                e.preventDefault()
                const selectedScope = select?.value
                const finalName = selectedScope === "custom..." ? customInput?.value : selectedScope
                if (!finalName || finalName === "custom...") {
                    customInput?.focus()
                    return
                }
                submit(form, register)
                if (activePopover) {
                    activePopover.hide()
                    activePopover = null
                }
            })
            customInput.addEventListener("keypress", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault()
                    if (saveBtn) {
                        saveBtn.click()
                    }
                }
            })
            if (!select.disabled) {
                select.focus()
            } else {
                customInput.focus()
            }
        })
        document.querySelectorAll("table").forEach(e => {
            const project = e.dataset.project
            if (!project) {
                return
            }
            const entity = e.dataset.entity
            if (!entity) {
                return
            }
            const key = e.dataset.key
            if (!key) {
                return
            }
            const body = e.querySelector("tbody")
            if (!body) {
                return
            }
            Sortable.create(body, {
                onUpdate: event => {
                    const fromIndex = event.oldIndex
                    const toIndex = event.newIndex
                    if (fromIndex === toIndex) {
                        return
                    }
                    send("Reorder", {
                        project: project,
                        entity: entity,
                        key: key,
                        fromIndex: fromIndex,
                        toIndex: toIndex,
                    }, "POST", register)
                }
            })
        })
        document.querySelectorAll(".color-picker").forEach(e => {
            const picker = e.jscolor
            picker.hideOnPaletteClick = true
            picker.onChange = () => {
                send("Project", {
                    objectID: e.dataset.project,
                    color: picker.toHEXString()
                }, "PATCH", register)
            }
        })
    }
    const init = () => {
        window.addEventListener("popstate", event => replace(event.state?.url ?? window.location.origin, register))
        register()
    }
    document.addEventListener("DOMContentLoaded", () => {
        init()
    }, {
        once: true
    })
</script>
 {block scripts}{/block}
</body>
</html>
