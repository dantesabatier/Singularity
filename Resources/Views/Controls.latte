{templateType App\Contexts\Editor}
{define controls}
    <div class="d-inline-block">
        <div class="dropdown d-inline-flex">
            <button type="button" class="btn border-0 bg-transparent p-2 dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="material-symbols-outlined">add</span>
            </button>
            <ul class="dropdown-menu">
                <li>
                    <button class="dropdown-item" type="button" onclick="add({App\Model\Entity::class|className}, undefined, {$project->model})">
                        Add Entity
                    </button>
                </li>
                <li>
                    <button class="dropdown-item" type="button" onclick="add({App\Model\FetchRequestTemplate::class|className}, {App\Model\FetchRequestTemplate::class|className|firstLower}, {$project->model})">
                        Add Fetch Request
                    </button>
                </li>
                <li>
                    <button class="dropdown-item" disabled>
                        Add Configuration
                    </button>
                </li>
                <li>
                    <hr class="dropdown-divider">
                </li>
                <li>
                    <button class="dropdown-item" type="button" onclick="add({App\Model\Attribute::class|className}, {App\Model\Attribute::class|className|firstLower}, {$selectedEntity})" {!$selectedEntity instanceof App\Model\Entity ? disabled}>
                        Add Attribute
                    </button>
                </li>
                <li>
                    <button class="dropdown-item" type="button" onclick="add({App\Model\FetchedProperty::class|className}, {App\Model\FetchedProperty::class|className|firstLower}, {$selectedEntity})" {!$selectedEntity instanceof App\Model\Entity ? disabled}>
                        Add Fetched Property
                    </button>
                </li>
                <li>
                    <button class="dropdown-item" type="button" onclick="add({App\Model\Relationship::class|className}, {App\Model\Relationship::class|className|firstLower}, {$selectedEntity})" {!$selectedEntity instanceof App\Model\Entity ? disabled}>
                        Add Relationship
                    </button>
                </li>
                <li>
                    <hr class="dropdown-divider">
                </li>
                <li>
                    <button class="dropdown-item" type="button" onclick="add({App\Model\FetchIndex::class|className}, {App\Model\FetchIndex::class|className|firstLower}, {$selectedEntity})" {!$selectedEntity instanceof App\Model\Entity || $selectedEntity->attributes->isEmpty ? disabled}>
                        Add Fetch Index
                    </button>
                </li>
            </ul>
        </div>
        {if $selectedIndex}
            <button class="btn border-0 bg-transparent p-2" onclick="remove({$selectedIndex})">
                <span class="material-symbols-outlined">remove</span>
            </button>
        {elseif $selectedEntity}
            <button class="btn border-0 bg-transparent p-2" onclick="remove({$selectedEntity})">
                <span class="material-symbols-outlined">remove</span>
            </button>
        {elseif $selectedFetchRequestTemplate}
            <button class="btn border-0 bg-transparent p-2" onclick="remove({$selectedFetchRequestTemplate})">
                <span class="material-symbols-outlined">remove</span>
            </button>
        {else}
            <button class="btn border-0 bg-transparent p-2" disabled>
                <span class="material-symbols-outlined">remove</span>
            </button>
        {/if}
    </div>
{/define}
