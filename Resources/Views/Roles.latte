{templateType App\ViewControllers\EditorController}
{varType Sabatier\Foundation\Set $allRoles}
{define roles}
    <template id="roles-popover-content">
        <div class="role-popover-container">
            <form action="/Role" method="POST" class="role-popover-form">
                <input type="hidden" name="X-Http-Method-Override" value="PATCH">
                <input type="hidden" name="objectID" value="{$selectedRole->objectID|json}">
                <div class="role-popover-field">
                    <label for="scopeSelect" class="role-popover-label">Role</label>
                    <select name="name" id="scopeSelect" class="form-select form-select-sm role-select" data-current-value="{$selectedRole?->name}">
                        <option n:foreach="$allRoles as $scope" value="{$scope}" {($isCustomRole ? $scope === 'Custom...' : $scope === $selectedRole?->name) ? selected}>
                            {$scope}
                        </option>
                    </select>
                </div>
                <div class="role-popover-field role-custom-field" style="{$isCustomRole ? '' : 'display: none;'}">
                    <label for="scopeName" class="role-popover-label">Custom Name</label>
                    <input type="text" name="name" id="scopeName" class="form-control form-control-sm" placeholder="custom_role" value="{$isCustomRole ? $selectedRole?->name : ''}" pattern="^[A-Z](?:\w*)?$" title="Letters and numbers only" {!$isCustomRole ? disabled}>
                    <small class="role-hint">Use letters: Guest, User</small>
                </div>
                <div n:if="$selectedRole !== null && $roleUsageCount > 1" class="role-popover-note">
                    Renaming affects {$roleUsageCount} access controls.
                </div>
            </form>
            <div class="role-popover-actions">
                <button n:if="$selectedRole !== null" type="button" class="btn btn-sm btn-link role-delete-btn" data-item="{['objectID' => $selectedRole->objectID->referenceObject, 'entityName' => $selectedRole->entityName, 'name' => $selectedRole->name]|json}" title="Delete role from the model">
                    <span class="material-symbols-outlined">delete</span>
                </button>
                <button type="button" class="btn btn-sm btn-secondary role-cancel-btn">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary role-save-btn">Save</button>
            </div>
        </div>
    </template>
{/define}
