{templateType App\ViewControllers\MappingController}
{define mappingSourceList}
    <div class="source-section-header">Mapping Models</div>
    <div class="source-section-content" style="flex: 1; overflow-y: auto;">
        <div n:foreach="$modelMaps as $modelMap" class="source-row{$modelMap->isEqual($selectedModelMap) ? ' active'}" id="modelMap-{$modelMap->objectID|json}" data-href="/Mapping?project={$project->objectID|json}&modelMap={$modelMap->objectID|json}" title="{$modelMap->name}">
            <span class="tree-spacer"></span>
            <span class="material-symbols-outlined source-icon">swap_horiz</span>
            <span class="source-label flex-grow-1">{$modelMap->name}</span>
        </div>
        <div n:if="$modelMaps->isEmpty" class="list-control-empty">No mapping models</div>
    </div>
{/define}
