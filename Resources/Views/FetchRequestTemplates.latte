{templateType App\ViewControllers\EditorController}
{define fetchRequestTemplates}
    <div n:foreach="$project->model->fetchRequestTemplates as $template" class="source-row{$template->isEqual($selectedFetchRequestTemplate) ? ' active'}"  data-href="/Editor?project={$project->objectID|json}&fetchRequest={$template->objectID|json}" style="--level: 0">
        <span class="tree-spacer"></span>
        <img class="source-icon" src="/Resources/Images/F@1x.png" srcset="/Resources/Images/F@2x.png 2x, /Resources/Images/F@3x.png 3x" alt="">
        <span class="source-label">{$template->name}</span>
    </div>
{/define}
