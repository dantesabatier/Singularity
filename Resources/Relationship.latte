{varType App\Model\Relationship $selectedProperty}
{varType Sabatier\Foundation\ArrayClass $allEntities}
{define relationship}
    <form action="/Relationship?objectID={$selectedProperty->objectID->referenceObject}" method="POST">
        <div class="mb-3 fs-5">
            Relationship
        </div>
        <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <input type="text" name="name" id="name" placeholder="Relationship Name" class="form-control text-truncate" value="{$selectedProperty->name}" autocomplete="off" required>
        </div>
        <div class="form-check form-check-inline">
            <label class="form-check-label" for="isTransient">Transient</label>
            <input class="form-check-input" type="checkbox" name="isTransient" value="{$selectedProperty->isTransient|json}" id="isTransient" {$selectedProperty->isTransient ? checked}>
        </div>
        <div class="form-check form-check-inline">
            <label class="form-check-label" for="isOptional">Optional</label>
            <input class="form-check-input" type="checkbox" name="isOptional" value="{$selectedProperty->isOptional|json}" id="isOptional" {$selectedProperty->isOptional ? checked}>
        </div>
        <hr>
        <div class="mt-3 mb-3">
            <label for="lazyDestinationEntityName" class="form-label">Destination</label>
            <select name="lazyDestinationEntityName" id="lazyDestinationEntityName" class="form-select" autosave>
                <option value="">No Destination Entity</option>
                <option n:foreach="$allEntities as $entity" value="{$entity->name}" {$entity->name === $selectedProperty->lazyDestinationEntityName ? selected}>
                    {$entity->name}
                </option>
            </select>
        </div>
        <div class="mb-3">
            <label for="lazyInverseRelationshipName" class="form-label">Inverse</label>
            <select name="lazyInverseRelationshipName" id="lazyInverseRelationshipName" class="form-select" autosave>
                <option value="">No Inverse Relationship</option>
                {var $destinationEntity = $selectedProperty->destinationEntity}
                        {if $destinationEntity}
                    <option n:foreach="$destinationEntity->relationships as $relationship" value="{$relationship->name}" {$relationship->name === $selectedProperty->lazyInverseRelationshipName ? selected}>
                        {$relationship->name}
                    </option>
                {/if}
            </select>
        </div>
        <div class="mb-3">
            {var $items = [0 => 'No Action', 1 => 'Nullify', 2 => 'Cascade', 3 => 'Deny']}
            <label for="deleteRule" class="form-label">Delete Rule</label>
            <select name="deleteRule" id="deleteRule" class="form-select" autosave>
                <option n:foreach="$items as $key => $value" value="{$key}" {$key === $selectedProperty->deleteRule ? selected}>
                    {$value}
                </option>
            </select>
        </div>
        <hr>
        <div class="mb-3">
            <div class="form-check{$selectedProperty->isToMany ? ' form-check-inline'}">
                <label class="form-check-label" for="isToMany">To Many</label>
                <input class="form-check-input" type="checkbox" name="isToMany" value="{$selectedProperty->isToMany|json}" id="isToMany" {$selectedProperty->isToMany ? checked}>
            </div>
            <div n:if="$selectedProperty->isToMany" class="form-check form-check-inline">
                <label class="form-check-label" for="isOrdered">Ordered</label>
                <input class="form-check-input" type="checkbox" name="isOrdered" value="{$selectedProperty->isOrdered|json}" id="isOrdered" {$selectedProperty->isOrdered ? checked}>
            </div>
        </div>
        <input type="hidden" name="X-Http-Method-Override" value="PATCH">
        <input class="d-none" type="submit">
    </form>
{/define}
