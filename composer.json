{
  "name": "sabatier/singularity",
  "description": "A set of tools to build web services in a bit.",
  "keywords": [
    "sabatier",
    "singularity"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "dantesabatier",
      "email": "dantesabatier@me.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-gettext": "*",
    "ext-intl": "*",
    "latte/latte": "^3.0",
    "sabatier/foundation": "@dev",
    "sabatier/coredata": "@dev",
    "sabatier/service": "@dev"
  },
  "config": {
    "platform": {
      "ext-pcntl": "8.3",
      "ext-posix": "8.3"
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src"
    },
    "files": [
      "src/Constants.php"
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0-dev"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Foundation"
    },
    {
      "type": "path",
      "url": "../CoreData"
    },
    {
      "type": "path",
      "url": "../Service"
    }
  ],
  "scripts": {
    "psalm": "vendor/bin/psalm --config=psalm.xml"
  }
}
