{
  "name": "sabatier/singularity",
  "description": "Design a data model and the PHP web service that backs it already exists — REST API, MCP tools and migrations included.",
  "keywords": [
    "sabatier",
    "singularity"
  ],
  "homepage": "https://github.com/dantesabatier/Singularity",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "dantesabatier",
      "email": "dantesabatier@me.com"
    }
  ],
  "support": {
    "issues": "https://github.com/dantesabatier/Singularity/issues",
    "source": "https://github.com/dantesabatier/Singularity",
    "security": "https://github.com/dantesabatier/Singularity/security/policy"
  },
  "require": {
    "php": "^8.5",
    "ext-json": "*",
    "ext-gettext": "*",
    "ext-intl": "*",
    "ext-redis": "*",
    "latte/latte": "^3.0",
    "sabatier/foundation": "^1.0",
    "sabatier/coredata": "^1.0",
    "sabatier/service": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3",
    "vimeo/psalm": "^6.17",
    "rector/rector": "^2.6"
  },
  "config": {
    "platform": {
      "ext-pcntl": "8.5",
      "ext-posix": "8.5"
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src"
    },
    "files": [
      "src/Constants.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0-dev"
    }
  }
}
